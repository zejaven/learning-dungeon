{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Executor wait-all trace event state",
  "description": "Shape of the state field for limited executor wait-all trace events.",
  "type": "object",
  "required": ["name", "main", "executor", "latch", "futures", "history"],
  "properties": {
    "name": { "type": "string" },
    "main": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "type": "string" },
        "waitingFor": { "type": "string" }
      }
    },
    "executor": {
      "type": ["object", "null"],
      "required": ["name", "workerCount", "shutdown", "workers", "queue", "completed"],
      "properties": {
        "name": { "type": "string" },
        "workerCount": { "type": "integer" },
        "shutdown": { "type": "boolean" },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "state", "tasksCompleted"],
            "properties": {
              "name": { "type": "string" },
              "state": { "type": "string" },
              "tasksCompleted": { "type": "integer" },
              "currentTask": { "type": "string" }
            }
          }
        },
        "queue": {
          "type": "array",
          "items": { "$ref": "#/definitions/task" }
        },
        "completed": {
          "type": "array",
          "items": { "$ref": "#/definitions/task" }
        }
      }
    },
    "latch": {
      "type": ["object", "null"],
      "required": ["name", "initialCount", "count", "released"],
      "properties": {
        "name": { "type": "string" },
        "initialCount": { "type": "integer" },
        "count": { "type": "integer" },
        "released": { "type": "boolean" }
      }
    },
    "futures": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/definitions/task" },
          {
            "type": "object",
            "required": ["done"],
            "properties": {
              "done": { "type": "boolean" },
              "result": {}
            }
          }
        ]
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "target"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "task": {
      "type": "object",
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string" },
        "state": { "type": "string" },
        "assignedWorker": { "type": "string" }
      }
    }
  },
  "events": [
    "TASK_BATCH_CREATED",
    "LIMITED_EXECUTOR_CREATED",
    "TASK_SUBMITTED",
    "TASK_STARTED",
    "TASK_QUEUED",
    "TASK_FINISHED",
    "LATCH_CREATED",
    "MAIN_AWAITING_LATCH",
    "LATCH_COUNTED_DOWN",
    "MAIN_RELEASED_BY_LATCH",
    "INVOKE_ALL_CALLED",
    "INVOKE_ALL_COMPLETED",
    "FUTURE_CREATED",
    "FUTURE_COMPLETED",
    "FUTURE_GET_WAITING",
    "FUTURE_GET_RETURNED",
    "EXECUTOR_SHUTDOWN"
  ]
}
