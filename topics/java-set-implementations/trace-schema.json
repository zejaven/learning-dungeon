{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Set implementation comparison trace event state",
  "description": "Shape of the `state` field for side-by-side HashSet, LinkedHashSet and TreeSet trace events.",
  "type": "object",
  "required": ["name", "operation", "note", "implementations"],
  "properties": {
    "name": { "type": "string" },
    "operation": { "type": "string" },
    "probe": { "type": ["string", "null"] },
    "note": { "type": "object", "properties": { "en": { "type": "string" }, "ru": { "type": "string" } } },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "structure",
          "order",
          "uniqueness",
          "cost",
          "size",
          "values",
          "lastResult"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "structure": { "type": "object", "properties": { "en": { "type": "string" }, "ru": { "type": "string" } } },
          "order": { "type": "object", "properties": { "en": { "type": "string" }, "ru": { "type": "string" } } },
          "uniqueness": { "type": "object", "properties": { "en": { "type": "string" }, "ru": { "type": "string" } } },
          "cost": { "type": "object", "properties": { "en": { "type": "string" }, "ru": { "type": "string" } } },
          "size": { "type": "integer" },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "value"],
              "properties": {
                "index": { "type": "integer" },
                "value": { "type": "string" }
              }
            }
          },
          "lastResult": {
            "type": "object",
            "required": ["status", "detail"],
            "properties": {
              "status": { "type": "string" },
              "detail": { "type": "object", "properties": { "en": { "type": "string" }, "ru": { "type": "string" } } }
            }
          }
        }
      }
    }
  },
  "events": [
    "SETS_CREATED",
    "SET_ADD",
    "SET_DUPLICATE",
    "SET_TREESET_COMPARATOR_DUPLICATE",
    "SET_NULL_POLICY",
    "SET_TREESET_REJECTED",
    "SET_CONTAINS",
    "SET_REMOVE",
    "SET_ITERATION_ORDER"
  ]
}
