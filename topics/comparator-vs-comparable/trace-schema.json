{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Comparator vs Comparable trace event state",
  "description": "Shape of the state field for ordering traces. The state shows values, the active ordering source, the last comparison, and safe integer comparison details when present.",
  "type": "object",
  "required": ["name", "order", "orderEn", "orderRu", "source", "operation", "values"],
  "properties": {
    "name": { "type": "string" },
    "order": { "type": "string" },
    "orderEn": { "type": "string" },
    "orderRu": { "type": "string" },
    "source": { "type": "string" },
    "operation": { "type": "string" },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "value"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": "string" },
          "numericValue": { "type": "integer" }
        }
      }
    },
    "lastComparison": {
      "type": "object",
      "required": ["source", "left", "right", "result", "sign", "meaningEn", "meaningRu"],
      "properties": {
        "source": { "type": "string" },
        "left": { "type": "string" },
        "right": { "type": "string" },
        "result": { "type": "integer" },
        "sign": { "type": "integer" },
        "meaningEn": { "type": "string" },
        "meaningRu": { "type": "string" }
      }
    },
    "safeCompare": {
      "type": "object",
      "required": [
        "fieldName",
        "leftLabel",
        "leftValue",
        "rightLabel",
        "rightValue",
        "subtractionResult",
        "safeResult",
        "overflowRisk"
      ],
      "properties": {
        "fieldName": { "type": "string" },
        "leftLabel": { "type": "string" },
        "leftValue": { "type": "integer" },
        "rightLabel": { "type": "string" },
        "rightValue": { "type": "integer" },
        "subtractionResult": { "type": "integer" },
        "safeResult": { "type": "integer" },
        "overflowRisk": { "type": "boolean" }
      }
    }
  },
  "events": [
    "ORDERING_CREATED",
    "ORDERING_VALUE_ADDED",
    "ORDERING_COMPARE_TO",
    "ORDERING_COMPARATOR_COMPARE",
    "ORDERING_COMPARE_ZERO",
    "ORDERING_SAFE_COMPARE",
    "ORDERING_SORTED"
  ]
}
