{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service timeout and fallback trace state",
  "description": "Shape of the `state` field for service-call resilience trace events.",
  "type": "object",
  "required": ["name", "elapsedMs", "deadlineMs", "savedMs", "strategy", "client", "services", "history"],
  "properties": {
    "name": { "type": "string" },
    "elapsedMs": { "type": "integer" },
    "deadlineMs": { "type": "integer" },
    "savedMs": { "type": "integer" },
    "strategy": { "type": "string" },
    "client": {
      "type": "object",
      "required": ["status", "responseStatus", "responseValue"],
      "properties": {
        "status": { "type": "string" },
        "responseStatus": { "type": "string" },
        "responseValue": { "type": "string" }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "latencyMs",
          "timeoutMs",
          "available",
          "status",
          "result",
          "failures",
          "circuit",
          "lastWaitMs",
          "fallback"
        ],
        "properties": {
          "name": { "type": "string" },
          "latencyMs": { "type": "integer" },
          "timeoutMs": { "type": "integer" },
          "available": { "type": "boolean" },
          "status": { "type": "string" },
          "result": { "type": "string" },
          "failures": { "type": "integer" },
          "circuit": { "type": "string" },
          "lastWaitMs": { "type": "integer" },
          "fallback": { "type": "string" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "target"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "SERVICE_SCENE_CREATED",
    "REQUEST_DEADLINE_SET",
    "SERVICE_REGISTERED",
    "SERVICE_CALL_STARTED",
    "SERVICE_CALL_SUCCEEDED",
    "SERVICE_TIMEOUT",
    "SERVICE_FALLBACK_USED",
    "PARALLEL_CALLS_STARTED",
    "PARALLEL_CALLS_JOINED",
    "CIRCUIT_OPENED",
    "CIRCUIT_SHORT_CIRCUITED",
    "CLIENT_RESPONDED"
  ]
}
