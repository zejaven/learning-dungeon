{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Static nested class trace event state",
  "description": "Shape of the state field for the static nested class topic. The state shows enclosing types, static class members, outer objects, and nested objects with or without hidden outer references.",
  "type": "object",
  "required": ["kind", "outerType", "staticNestedType", "innerType", "types", "staticMembers", "outerObjects", "nestedObjects"],
  "properties": {
    "kind": { "type": "string", "enum": ["staticNestedClass"] },
    "outerType": { "type": "string" },
    "staticNestedType": { "type": "string" },
    "innerType": { "type": "string" },
    "note": { "type": "string" },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "needsOuter"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "needsOuter": { "type": "boolean" }
        }
      }
    },
    "staticMembers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "value"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "outerObjects": {
      "type": "array",
      "items": { "$ref": "#/definitions/object" }
    },
    "nestedObjects": {
      "type": "array",
      "items": { "$ref": "#/definitions/object" }
    }
  },
  "definitions": {
    "object": {
      "type": "object",
      "required": ["id", "type", "label", "outerRef", "fields"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "outerRef": { "type": ["string", "null"] },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "events": [
    "STATIC_NESTED_DECLARED",
    "OUTER_INSTANCE_CREATED",
    "STATIC_NESTED_CREATED",
    "INNER_CLASS_CREATED",
    "STATIC_MEMBER_SET",
    "STATIC_MEMBER_ACCESS"
  ]
}
