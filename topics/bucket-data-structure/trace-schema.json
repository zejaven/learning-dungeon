{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bucket data structure trace event state",
  "description": "Shape of the `state` field for a single HashMap bucket that may be a linked list or a red-black tree.",
  "type": "object",
  "required": ["index", "structure", "count", "list"],
  "properties": {
    "index": { "type": "integer" },
    "capacity": { "type": "integer" },
    "structure": { "type": "string", "enum": ["list", "tree"] },
    "count": { "type": "integer" },
    "treeifyThreshold": { "type": "integer" },
    "untreeifyThreshold": { "type": "integer" },
    "minTreeifyCapacity": { "type": "integer" },
    "list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value", "hash"],
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" },
          "hash": { "type": "integer" }
        }
      }
    },
    "tree": {
      "type": ["object", "null"],
      "required": ["key", "value", "hash"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "hash": { "type": "integer" },
        "color": { "type": "string", "enum": ["R", "B"] },
        "left": { "type": ["object", "null"] },
        "right": { "type": ["object", "null"] }
      }
    }
  },
  "events": [
    "BUCKET_CREATED",
    "LIST_ADD",
    "TREEIFY",
    "TREE_ADD",
    "LIST_GET",
    "TREE_GET",
    "UNTREEIFY",
    "TREEIFY_SKIPPED"
  ]
}
