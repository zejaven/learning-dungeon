{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JPA entity lifecycle trace event state",
  "description": "Shape of the `state` field for JPA entity lifecycle trace events.",
  "type": "object",
  "required": ["contextName", "contextOpen", "operation", "entities", "databaseRows", "sqlLog"],
  "properties": {
    "contextName": { "type": "string" },
    "contextOpen": { "type": "boolean" },
    "operation": { "type": "string" },
    "managedCount": { "type": "integer" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["handle", "label", "id", "state", "changed", "pendingAction"],
        "properties": {
          "handle": { "type": "string" },
          "label": { "type": "string" },
          "id": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["TRANSIENT", "MANAGED", "DETACHED", "REMOVED"]
          },
          "changed": { "type": "boolean" },
          "pendingAction": { "type": "string" }
        }
      }
    },
    "databaseRows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "deleted"],
        "properties": {
          "id": { "type": "integer" },
          "label": { "type": "string" },
          "deleted": { "type": "boolean" }
        }
      }
    },
    "sqlLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "kind", "sql"],
        "properties": {
          "n": { "type": "integer" },
          "kind": {
            "type": "string",
            "enum": ["insert", "update", "delete"]
          },
          "sql": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "JPA_CONTEXT_CREATED",
    "JPA_ENTITY_TRANSIENT",
    "JPA_PERSIST",
    "JPA_FIND",
    "JPA_CHANGE",
    "JPA_DETACH",
    "JPA_CLEAR",
    "JPA_CLOSE",
    "JPA_MERGE",
    "JPA_REMOVE",
    "JPA_FLUSH"
  ]
}
