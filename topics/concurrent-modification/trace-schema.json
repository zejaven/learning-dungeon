{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConcurrentModification trace event state",
  "description": "Shape of the state field for ConcurrentModificationException and safe-collection-change trace events.",
  "type": "object",
  "required": ["name", "mode", "modCount", "elements", "iterator", "history"],
  "properties": {
    "name": { "type": "string" },
    "mode": { "type": "string", "enum": ["FAIL_FAST", "COPY_ON_WRITE"] },
    "modCount": { "type": "integer" },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "value"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": "string" }
        }
      }
    },
    "iterator": {
      "type": "object",
      "required": ["active", "expectedModCount", "cursor", "lastReturned", "snapshot", "stale"],
      "properties": {
        "active": { "type": "boolean" },
        "expectedModCount": { "type": "integer" },
        "cursor": { "type": "integer" },
        "lastReturned": { "type": "integer" },
        "snapshot": { "type": "array", "items": { "type": "string" } },
        "stale": { "type": "boolean" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "detail"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "LIST_CREATED",
    "LIST_ADD",
    "LIST_REMOVE",
    "ITERATOR_CREATED",
    "ITERATOR_NEXT",
    "ITERATOR_REMOVE",
    "CONCURRENT_MODIFICATION",
    "ITERATION_DONE",
    "COW_WRITE_COPY",
    "COW_SNAPSHOT_READ",
    "COW_REMOVE_UNSUPPORTED"
  ]
}
