{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monitor wait/notify trace event state",
  "description": "Shape of the state field for synchronized wait/notify trace events.",
  "type": "object",
  "required": [
    "name",
    "conditionReady",
    "owner",
    "monitorState",
    "waitSet",
    "entrySet",
    "threads",
    "history"
  ],
  "properties": {
    "name": { "type": "string" },
    "conditionReady": { "type": "boolean" },
    "owner": { "type": ["string", "null"] },
    "monitorState": { "type": "string", "enum": ["FREE", "OWNED"] },
    "waitSet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread"],
        "properties": {
          "thread": { "type": "string" }
        }
      }
    },
    "entrySet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "reason"],
        "properties": {
          "thread": { "type": "string" },
          "reason": { "type": "string", "enum": ["enter", "notified", "spurious"] }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "lastCheck": { "type": "boolean" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "MONITOR_CREATED",
    "MONITOR_ENTER",
    "MONITOR_BLOCKED",
    "CONDITION_CHECK_TRUE",
    "CONDITION_CHECK_FALSE",
    "CONDITION_UPDATED",
    "MONITOR_WAIT_RELEASED",
    "MONITOR_NOTIFY",
    "MONITOR_NOTIFY_NO_WAITER",
    "MONITOR_NOTIFY_ALL",
    "MONITOR_SPURIOUS_WAKEUP",
    "MONITOR_EXIT",
    "MONITOR_ENTRY_GRANTED",
    "MONITOR_REACQUIRED"
  ]
}
