{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Method call stack frames trace event state",
  "description": "Shape of the state field for method-call-stack-frames trace events: one call stack made of frames plus heap objects referenced by frame slots.",
  "type": "object",
  "required": ["frames", "heap"],
  "properties": {
    "frames": {
      "type": "array",
      "description": "The current thread's call stack, bottom frame first.",
      "items": {
        "type": "object",
        "required": ["name", "vars"],
        "properties": {
          "name": { "type": "string" },
          "vars": {
            "type": "array",
            "description": "Named local variables or parameters in this frame.",
            "items": {
              "type": "object",
              "required": ["name", "kind", "type", "value", "ref"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string", "enum": ["primitive", "reference"] },
                "type": { "type": "string" },
                "value": { "type": ["string", "null"] },
                "ref": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "heap": {
      "type": "array",
      "description": "Heap objects, in allocation order.",
      "items": {
        "type": "object",
        "required": ["id", "type", "fields", "referenced"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          },
          "referenced": { "type": "boolean" }
        }
      }
    }
  },
  "events": [
    "MEM_SCENE",
    "MEM_PRIMITIVE",
    "MEM_COPY_PRIMITIVE",
    "MEM_SET_PRIMITIVE",
    "MEM_NEW",
    "MEM_COPY_REFERENCE",
    "MEM_MUTATE",
    "MEM_REASSIGN",
    "MEM_NULL",
    "MEM_CALL",
    "MEM_RETURN"
  ]
}
