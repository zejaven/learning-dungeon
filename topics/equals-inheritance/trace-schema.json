{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "equals inheritance trace event state",
  "description": "Shape of the `state` field for equals() and inheritance trace events.",
  "type": "object",
  "required": ["scenario", "objects", "comparisons", "checks", "probes"],
  "properties": {
    "scenario": { "type": "string" },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "type", "fields"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "fields": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "left", "right", "expression", "method", "result", "event"],
        "properties": {
          "id": { "type": "string" },
          "left": { "type": "string" },
          "right": { "type": "string" },
          "expression": { "type": "string" },
          "method": { "type": "string" },
          "result": { "type": "boolean" },
          "event": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ids", "ok", "details"],
        "properties": {
          "kind": { "type": "string" },
          "ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "ok": { "type": "boolean" },
          "details": { "type": "string" }
        }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expression", "result"],
        "properties": {
          "expression": { "type": "string" },
          "result": { "type": "boolean" }
        }
      }
    }
  },
  "events": [
    "EQUALITY_SCENARIO",
    "EQUALITY_OBJECTS",
    "EQUALITY_COMPARE",
    "EQUALITY_SYMMETRY_OK",
    "EQUALITY_SYMMETRY_BROKEN",
    "EQUALITY_TRANSITIVITY_OK",
    "EQUALITY_TRANSITIVITY_BROKEN",
    "EQUALITY_GETCLASS_GUARD",
    "EQUALITY_COLLECTION_SURPRISE",
    "EQUALITY_CAN_EQUAL",
    "EQUALITY_COMPOSITION"
  ]
}
