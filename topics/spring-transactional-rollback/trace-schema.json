{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spring @Transactional rollback trace event state",
  "description": "Shape of the state field for Spring transaction rollback-rule trace events.",
  "type": "object",
  "required": ["name", "phase", "database", "rollbackOnly", "staged", "rules"],
  "properties": {
    "name": { "type": "string" },
    "phase": {
      "type": "string",
      "enum": ["idle", "active", "committed", "rolled_back", "external_failed"]
    },
    "currentMethod": { "type": "string" },
    "rollbackOnly": { "type": "boolean" },
    "staged": {
      "type": "array",
      "description": "Rows staged in the current transaction but not committed yet.",
      "items": {
        "type": "object",
        "required": ["id", "value"],
        "properties": {
          "id": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "database": {
      "type": "array",
      "description": "Rows that have committed and are durable.",
      "items": {
        "type": "object",
        "required": ["id", "value"],
        "properties": {
          "id": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": ["rollbackFor", "noRollbackFor"],
      "properties": {
        "rollbackFor": {
          "type": "array",
          "items": { "type": "string" }
        },
        "noRollbackFor": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "exception": {
      "type": "object",
      "required": ["name", "kind", "source", "decision", "matchedRule"],
      "properties": {
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["runtime", "checked", "error"]
        },
        "source": { "type": "string" },
        "decision": {
          "type": "string",
          "enum": ["pending", "rollback", "commit", "none"]
        },
        "matchedRule": { "type": "string" }
      }
    }
  },
  "events": [
    "SPRING_TX_MANAGER_CREATED",
    "SPRING_TX_BEGIN",
    "SPRING_TX_ROLLBACK_RULE_ADDED",
    "SPRING_TX_NO_ROLLBACK_RULE_ADDED",
    "SPRING_ENTITY_PERSISTED",
    "SPRING_EXTERNAL_CALL",
    "SPRING_EXTERNAL_CALL_FAILED",
    "SPRING_EXCEPTION_THROWN",
    "SPRING_TX_DEFAULT_ROLLBACK",
    "SPRING_TX_CHECKED_COMMIT",
    "SPRING_TX_ROLLBACK_FOR_MATCH",
    "SPRING_TX_NO_ROLLBACK_FOR_MATCH",
    "SPRING_TX_COMMITTED",
    "SPRING_TX_ROLLED_BACK",
    "SPRING_EXTERNAL_EXCEPTION_AFTER_COMMIT"
  ]
}
