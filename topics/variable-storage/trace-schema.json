{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Variable storage trace event state",
  "description": "Shape of the `state` field for variable-storage trace events: a call stack of frames and a heap of objects.",
  "type": "object",
  "required": ["frames", "heap"],
  "properties": {
    "frames": {
      "type": "array",
      "description": "The call stack, bottom frame (main) first.",
      "items": {
        "type": "object",
        "required": ["name", "vars"],
        "properties": {
          "name": { "type": "string" },
          "vars": {
            "type": "array",
            "description": "Named variables (stack slots) in this frame.",
            "items": {
              "type": "object",
              "required": ["name", "kind", "type", "value", "ref"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string", "enum": ["primitive", "reference"] },
                "type": { "type": "string", "description": "declared type, e.g. int or Point" },
                "value": { "type": ["string", "null"], "description": "the value held in the slot (for a primitive); null for a reference" },
                "ref": { "type": ["string", "null"], "description": "id of the heap object referenced (for a reference); null for a primitive or a null reference" }
              }
            }
          }
        }
      }
    },
    "heap": {
      "type": "array",
      "description": "Heap objects, in allocation order.",
      "items": {
        "type": "object",
        "required": ["id", "type", "fields", "referenced"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          },
          "referenced": { "type": "boolean", "description": "reachable from a stack slot; false = garbage" }
        }
      }
    }
  },
  "events": [
    "MEM_SCENE",
    "MEM_PRIMITIVE",
    "MEM_COPY_PRIMITIVE",
    "MEM_SET_PRIMITIVE",
    "MEM_NEW",
    "MEM_COPY_REFERENCE",
    "MEM_MUTATE",
    "MEM_REASSIGN",
    "MEM_NULL",
    "MEM_CALL",
    "MEM_RETURN"
  ]
}
