{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thread-safe addition trace event state",
  "description": "Shape of the state field for numeric addition thread-safety trace events.",
  "type": "object",
  "required": ["name", "sharedValue", "waitingQueue", "threads", "history"],
  "properties": {
    "name": { "type": "string" },
    "sharedValue": { "type": "integer" },
    "owner": { "type": ["string", "null"] },
    "waitingQueue": {
      "type": "array",
      "items": { "type": "string" }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "lastRead": { "type": "integer" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "action"],
        "properties": {
          "thread": { "type": "string" },
          "action": { "type": "string" },
          "value": { "type": "integer" }
        }
      }
    }
  },
  "events": [
    "CRITICAL_SECTION_CREATED",
    "CRITICAL_SECTION_ENTER",
    "THREAD_WAITING",
    "SHARED_READ",
    "SHARED_WRITE",
    "CRITICAL_SECTION_EXIT",
    "UNSAFE_READ",
    "UNSAFE_WRITE",
    "LOST_UPDATE",
    "OUTSIDE_WORK"
  ]
}
