{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reference-types heap trace event state",
  "description": "Shape of the `state` field for VisualRefHeap trace events.",
  "type": "object",
  "required": ["objects", "references"],
  "properties": {
    "memoryLow": { "type": "boolean" },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "collected", "reachability"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "collected": { "type": "boolean" },
          "reachability": {
            "type": "string",
            "enum": ["strong", "soft", "weak", "phantom", "unreachable", "collected"]
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "target", "cleared", "queued"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["strong", "soft", "weak", "phantom"] },
          "target": { "type": "string" },
          "cleared": { "type": "boolean" },
          "queued": { "type": "boolean" }
        }
      }
    },
    "queue": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "events": [
    "REF_HEAP_CREATED",
    "REF_ALLOCATE",
    "REF_STRONG",
    "REF_SOFT",
    "REF_WEAK",
    "REF_PHANTOM",
    "REF_DROP",
    "REF_GET",
    "REF_GC",
    "REF_GC_PRESSURE",
    "REF_COLLECT",
    "REF_ENQUEUE"
  ]
}
