{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spring circular dependency trace event state",
  "description": "Shape of the state field for Spring bean dependency trace events.",
  "type": "object",
  "required": ["name", "phase", "beans", "dependencies", "stack"],
  "properties": {
    "name": { "type": "string" },
    "phase": {
      "type": "string",
      "enum": ["defined", "refreshing", "ready", "failed"]
    },
    "beans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["defined", "creating", "ready", "failed"]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind", "status"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["constructor", "lazy", "provider"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "resolving", "resolved", "deferred", "failed"]
          }
        }
      }
    },
    "stack": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "events": [
    "SPRING_CONTEXT_CREATED",
    "SPRING_BEAN_REGISTERED",
    "SPRING_DEPENDENCY_LINKED",
    "SPRING_REFRESH_STARTED",
    "SPRING_BEAN_CREATION_STARTED",
    "SPRING_DEPENDENCY_RESOLVE",
    "SPRING_CYCLE_DETECTED",
    "SPRING_CONTEXT_FAILED",
    "SPRING_LAZY_PROXY_INJECTED",
    "SPRING_PROVIDER_INJECTED",
    "SPRING_BEAN_READY",
    "SPRING_CONTEXT_READY",
    "SPRING_LAZY_TARGET_REQUESTED",
    "SPRING_LAZY_TARGET_RESOLVED",
    "SPRING_PROVIDER_REQUESTED",
    "SPRING_PROVIDER_TARGET_RETURNED"
  ]
}
