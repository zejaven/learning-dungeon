{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Concurrent vs synchronized collections trace event state",
  "description": "Shape of the state field for synchronized and concurrent collection trace events.",
  "type": "object",
  "required": [
    "name",
    "kind",
    "strategy",
    "version",
    "waitingQueue",
    "entries",
    "threads",
    "iterators",
    "history"
  ],
  "properties": {
    "name": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["SYNCHRONIZED_LIST", "CONCURRENT_HASH_MAP", "COPY_ON_WRITE_ARRAY_LIST"]
    },
    "strategy": { "type": "string" },
    "owner": { "type": ["string", "null"] },
    "version": { "type": "integer" },
    "waitingQueue": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "operation": { "type": "string" }
        }
      }
    },
    "iterators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "thread", "mode", "cursor", "expectedVersion", "status", "snapshot"],
        "properties": {
          "name": { "type": "string" },
          "thread": { "type": "string" },
          "mode": { "type": "string" },
          "cursor": { "type": "integer" },
          "expectedVersion": { "type": "integer" },
          "status": { "type": "string" },
          "snapshot": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value"],
              "properties": {
                "key": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "action"],
        "properties": {
          "thread": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "COLLECTION_CREATED",
    "SYNC_LOCK_ACQUIRED",
    "SYNC_THREAD_BLOCKED",
    "SYNC_WRITE",
    "SYNC_LOCK_RELEASED",
    "ITERATOR_CREATED",
    "FAIL_FAST_ITERATOR_INVALIDATED",
    "CONCURRENT_WRITE",
    "CONCURRENT_READ",
    "ATOMIC_PUT_IF_ABSENT",
    "WEAK_ITERATOR_CREATED",
    "WEAK_ITERATOR_CONTINUES",
    "SNAPSHOT_ITERATOR_CREATED",
    "COPY_ON_WRITE_WRITE",
    "SNAPSHOT_ITERATOR_READ",
    "ITERATOR_NEXT",
    "ITERATOR_EXHAUSTED"
  ]
}
