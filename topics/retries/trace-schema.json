{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retry trace state",
  "description": "Shape of the `state` field for VisualRetry trace events.",
  "type": "object",
  "required": ["name", "policy", "operation", "idempotent", "idempotencyKey", "status", "clockMs",
               "serverCalls", "peak", "attempts", "slots", "layers", "history"],
  "properties": {
    "name": { "type": "string" },
    "policy": {
      "type": "object",
      "required": ["maxAttempts", "baseDelayMs", "multiplier", "maxDelayMs", "jitter",
                   "attemptTimeoutMs", "deadlineMs", "budgetMax", "budgetTokens"],
      "properties": {
        "maxAttempts": { "type": "integer" },
        "baseDelayMs": { "type": "integer" },
        "multiplier": { "type": "string" },
        "maxDelayMs": { "type": "integer" },
        "jitter": { "enum": ["NONE", "FULL", "EQUAL"] },
        "attemptTimeoutMs": { "type": "integer" },
        "deadlineMs": { "type": "integer", "description": "0 = no deadline" },
        "budgetMax": { "type": "integer", "description": "-1 = no retry budget" },
        "budgetTokens": { "type": "integer" }
      }
    },
    "operation": { "type": "string" },
    "idempotent": { "type": "boolean" },
    "idempotencyKey": { "type": "string" },
    "status": { "enum": ["IDLE", "CALLING", "BACKING_OFF", "SUCCEEDED", "FAILED", "DONE"] },
    "clockMs": { "type": "integer" },
    "serverCalls": { "type": "integer" },
    "peak": { "type": "integer" },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "atMs", "outcome", "verdict", "delayMs"],
        "properties": {
          "n": { "type": "integer" },
          "atMs": { "type": "integer" },
          "outcome": { "type": "string" },
          "verdict": { "enum": ["PENDING", "OK", "TRANSIENT", "AMBIGUOUS", "PERMANENT"] },
          "delayMs": { "type": "integer" }
        }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fromMs", "count"],
        "properties": {
          "fromMs": { "type": "integer" },
          "count": { "type": "integer" }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "retries", "calls"],
        "properties": {
          "name": { "type": "string" },
          "retries": { "type": "boolean" },
          "calls": { "type": "integer" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "target"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "RETRY_SCENE_CREATED",
    "RETRY_POLICY_SET",
    "SERVER_SCRIPTED",
    "ATTEMPT_STARTED",
    "ATTEMPT_FAILED",
    "BACKOFF_SCHEDULED",
    "RETRY_AFTER_HONORED",
    "CALL_SUCCEEDED",
    "RETRY_SKIPPED_NON_RETRYABLE",
    "RETRY_SKIPPED_NOT_IDEMPOTENT",
    "ATTEMPTS_EXHAUSTED",
    "RETRY_BUDGET_EXHAUSTED",
    "DEADLINE_EXCEEDED",
    "HERD_RETRIES_SYNCHRONIZED",
    "HERD_RETRIES_SPREAD",
    "LAYER_CALLED",
    "RETRY_AMPLIFIED",
    "RETRY_CONTAINED"
  ]
}
