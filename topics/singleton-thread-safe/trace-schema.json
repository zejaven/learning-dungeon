{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thread-safe Singleton trace event state",
  "description": "Shape of the state field for Singleton construction and publication trace events.",
  "type": "object",
  "required": [
    "name",
    "strategy",
    "constructorCalls",
    "volatileField",
    "enumBased",
    "threads",
    "history"
  ],
  "properties": {
    "name": { "type": "string" },
    "strategy": { "type": "string" },
    "instance": { "type": ["string", "null"] },
    "constructorCalls": { "type": "integer" },
    "lockOwner": { "type": ["string", "null"] },
    "volatileField": { "type": "boolean" },
    "enumBased": { "type": "boolean" },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "observedInstance": { "type": "string" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "action"],
        "properties": {
          "thread": { "type": "string" },
          "action": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "SINGLETON_MODEL_CREATED",
    "SINGLETON_UNSAFE_CHECK",
    "SINGLETON_INSTANCE_CREATED",
    "SINGLETON_DUPLICATE_CREATED",
    "SINGLETON_SYNCHRONIZED_LOCK",
    "SINGLETON_LOCK_RELEASED",
    "SINGLETON_DCL_FIRST_CHECK",
    "SINGLETON_DCL_SECOND_CHECK",
    "SINGLETON_VOLATILE_PUBLISH",
    "SINGLETON_INSTANCE_REUSED",
    "SINGLETON_ENUM_READY",
    "SINGLETON_ENUM_ACCESS"
  ]
}
