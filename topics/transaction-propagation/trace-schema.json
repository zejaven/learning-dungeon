{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction propagation trace event state",
  "description": "Shape of the `state` field for transaction propagation trace events.",
  "type": "object",
  "required": ["operation", "activeTx", "depth", "frames", "physicalTransactions"],
  "properties": {
    "operation": { "type": "string" },
    "activeTx": { "type": "string" },
    "depth": { "type": "integer" },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["handle", "method", "propagation", "physicalTx", "roleKind", "savepoint", "depth", "active", "status"],
        "properties": {
          "handle": { "type": "string" },
          "method": { "type": "string" },
          "propagation": {
            "type": "string",
            "enum": ["REQUIRED", "REQUIRES_NEW", "NESTED", "SUPPORTS", "NOT_SUPPORTED", "MANDATORY", "NEVER"]
          },
          "physicalTx": { "type": "string" },
          "roleKind": {
            "type": "string",
            "enum": ["", "START", "JOIN", "SAVEPOINT", "NONE", "ERROR"]
          },
          "savepoint": { "type": "string" },
          "depth": { "type": "integer" },
          "active": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "COMMITTED", "ROLLED_BACK", "RELEASED", "RETURNED", "ERROR"]
          }
        }
      }
    },
    "physicalTransactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "rollbackOnly", "savepoints"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "SUSPENDED", "COMMITTED", "ROLLED_BACK"]
          },
          "rollbackOnly": { "type": "boolean" },
          "savepoints": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "events": [
    "TX_START_PHYSICAL",
    "TX_JOIN",
    "TX_SUSPEND",
    "TX_RESUME",
    "TX_SAVEPOINT",
    "TX_NON_TRANSACTIONAL",
    "TX_ERROR",
    "TX_COMMIT",
    "TX_ROLLBACK",
    "TX_ROLLBACK_SAVEPOINT",
    "TX_RELEASE_SAVEPOINT",
    "TX_MARK_ROLLBACK",
    "TX_UNEXPECTED_ROLLBACK",
    "TX_RETURN"
  ]
}
