{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "N+1 fetch trace event state",
  "description": "Shape of the `state` field for N+1 fetch-strategy trace events.",
  "type": "object",
  "required": ["strategy", "queryCount", "parents", "queries"],
  "properties": {
    "scene": { "type": "string" },
    "strategy": {
      "type": "string",
      "enum": ["LAZY", "JOIN_FETCH", "ENTITY_GRAPH", "BATCH"]
    },
    "batchSize": { "type": "integer" },
    "parentTable": { "type": "string" },
    "childTable": { "type": "string" },
    "queryCount": { "type": "integer" },
    "parents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "loaded"],
        "properties": {
          "id": { "type": "integer" },
          "label": { "type": "string" },
          "childCount": { "type": "integer" },
          "loaded": { "type": "boolean" }
        }
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "kind", "sql"],
        "properties": {
          "n": { "type": "integer" },
          "kind": {
            "type": "string",
            "enum": ["root", "nplus1", "joinfetch", "entitygraph", "batch"]
          },
          "sql": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "N_PLUS_ONE_CREATED",
    "ROOT_QUERY",
    "N_PLUS_ONE_QUERY",
    "JOIN_FETCH_QUERY",
    "ENTITY_GRAPH_QUERY",
    "BATCH_SIZE_SET",
    "BATCH_QUERY",
    "COLLECTION_ALREADY_LOADED"
  ]
}
