{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spring @Transactional proxy trace event state",
  "description": "Shape of the state field for Spring @Transactional proxy/AOP trace events.",
  "type": "object",
  "required": ["bean", "proxy", "txActive", "txOwner", "stack", "staged", "database"],
  "properties": {
    "bean": { "type": "string" },
    "proxy": { "type": "string" },
    "txActive": { "type": "boolean" },
    "txOwner": { "type": "string" },
    "stack": {
      "type": "array",
      "description": "Active method call frames, outermost first.",
      "items": {
        "type": "object",
        "required": ["method", "via", "transactional", "inTx"],
        "properties": {
          "method": { "type": "string" },
          "via": {
            "type": "string",
            "enum": ["proxy", "self", "direct"]
          },
          "transactional": { "type": "boolean" },
          "inTx": { "type": "boolean" }
        }
      }
    },
    "staged": {
      "type": "array",
      "description": "Rows staged in the current transaction but not committed yet.",
      "items": {
        "type": "object",
        "required": ["id", "value"],
        "properties": {
          "id": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "database": {
      "type": "array",
      "description": "Rows that are durable in the database.",
      "items": {
        "type": "object",
        "required": ["id", "value"],
        "properties": {
          "id": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "TX_PROXY_CREATED",
    "TX_PROXY_INTERCEPT",
    "TX_BEGIN",
    "TX_PERSIST",
    "TX_SELF_INVOCATION",
    "TX_DIRECT_CALL",
    "TX_NO_TRANSACTION",
    "TX_COMMIT",
    "TX_ROLLBACK",
    "TX_RETURN"
  ]
}
