{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@TransactionalEventListener trace event state",
  "description": "Shape of the state field for Spring transactional event listener trace events.",
  "type": "object",
  "required": ["name", "phase", "completion", "staged", "database", "publishedEvents", "deliveries", "listeners"],
  "properties": {
    "name": { "type": "string" },
    "phase": {
      "type": "string",
      "enum": ["idle", "active", "before_commit", "committed", "rolled_back", "after_completion", "no_transaction"]
    },
    "currentMethod": { "type": "string" },
    "completion": {
      "type": "string",
      "enum": ["none", "commit", "rollback"]
    },
    "staged": {
      "type": "array",
      "items": { "$ref": "#/definitions/row" }
    },
    "database": {
      "type": "array",
      "items": { "$ref": "#/definitions/row" }
    },
    "publishedEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["queued", "committed", "rolled_back", "no_transaction"]
          }
        }
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "event", "listener", "phase", "status", "fallbackExecution"],
        "properties": {
          "id": { "type": "string" },
          "event": { "type": "string" },
          "listener": { "type": "string" },
          "phase": {
            "type": "string",
            "enum": ["BEFORE_COMMIT", "AFTER_COMMIT", "AFTER_ROLLBACK", "AFTER_COMPLETION"]
          },
          "status": {
            "type": "string",
            "enum": ["waiting", "done", "skipped", "failed"]
          },
          "fallbackExecution": { "type": "boolean" }
        }
      }
    },
    "listeners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "phase", "fallbackExecution", "invocations", "failed"],
        "properties": {
          "name": { "type": "string" },
          "phase": {
            "type": "string",
            "enum": ["BEFORE_COMMIT", "AFTER_COMMIT", "AFTER_ROLLBACK", "AFTER_COMPLETION"]
          },
          "fallbackExecution": { "type": "boolean" },
          "invocations": { "type": "integer" },
          "failed": { "type": "boolean" }
        }
      }
    },
    "failure": {
      "type": "object",
      "required": ["listener", "phase", "exception", "effect"],
      "properties": {
        "listener": { "type": "string" },
        "phase": {
          "type": "string",
          "enum": ["BEFORE_COMMIT", "AFTER_COMMIT", "AFTER_ROLLBACK", "AFTER_COMPLETION"]
        },
        "exception": { "type": "string" },
        "effect": {
          "type": "string",
          "enum": ["rollback", "cannot_rollback_completed_transaction"]
        }
      }
    }
  },
  "definitions": {
    "row": {
      "type": "object",
      "required": ["id", "value"],
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  },
  "events": [
    "TX_EVENT_MODEL_CREATED",
    "TX_EVENT_LISTENER_REGISTERED",
    "TX_EVENT_BEGIN",
    "TX_EVENT_ENTITY_PERSISTED",
    "TX_EVENT_PUBLISHED",
    "TX_EVENT_LISTENER_FAILURE_ARMED",
    "TX_EVENT_BEFORE_COMMIT",
    "TX_EVENT_BEFORE_COMMIT_FAILED",
    "TX_EVENT_COMMITTED",
    "TX_EVENT_AFTER_COMMIT",
    "TX_EVENT_AFTER_COMMIT_FAILED",
    "TX_EVENT_ROLLED_BACK",
    "TX_EVENT_AFTER_ROLLBACK",
    "TX_EVENT_AFTER_COMPLETION",
    "TX_EVENT_NO_TRANSACTION_SKIPPED",
    "TX_EVENT_FALLBACK_EXECUTED"
  ]
}
