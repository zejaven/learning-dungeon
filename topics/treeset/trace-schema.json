{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TreeSet trace event state",
  "description": "Shape of the `state` field for TreeSet trace events. The values array is always in TreeSet iteration order.",
  "type": "object",
  "required": ["name", "order", "size", "values", "lastOp"],
  "properties": {
    "name": { "type": "string" },
    "order": { "type": "string" },
    "orderEn": { "type": "string" },
    "orderRu": { "type": "string" },
    "size": { "type": "integer" },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "value"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": "string" }
        }
      }
    },
    "lastOp": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "probe": { "type": ["string", "null"] },
        "result": { "type": ["string", "null"] }
      }
    },
    "range": {
      "type": "object",
      "required": ["from", "fromInclusive", "to", "toInclusive", "values"],
      "properties": {
        "from": { "type": "string" },
        "fromInclusive": { "type": "boolean" },
        "to": { "type": "string" },
        "toInclusive": { "type": "boolean" },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "TREESET_CREATED",
    "TREESET_ADD",
    "TREESET_DUPLICATE",
    "TREESET_CONTAINS",
    "TREESET_REMOVE",
    "TREESET_NAVIGATE",
    "TREESET_RANGE"
  ]
}
