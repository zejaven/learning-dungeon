{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Streams vs loops performance trace event state",
  "description": "Shape of the `state` field for Stream and loop performance trace events.",
  "type": "object",
  "required": ["mode", "source", "stages", "counters"],
  "properties": {
    "name": { "type": "string" },
    "mode": { "type": "string" },
    "plan": { "type": "string" },
    "source": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "value", "status"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": "integer" },
          "status": { "type": "string" }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "value"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "status": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "values", "sum", "status"],
        "properties": {
          "id": { "type": "string" },
          "values": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "sum": { "type": "integer" },
          "status": { "type": "string" }
        }
      }
    },
    "counters": {
      "type": "object",
      "required": [
        "loopIterations",
        "stageCalls",
        "boxedConversions",
        "primitiveSteps",
        "splits",
        "merges"
      ],
      "properties": {
        "loopIterations": { "type": "integer" },
        "stageCalls": { "type": "integer" },
        "boxedConversions": { "type": "integer" },
        "primitiveSteps": { "type": "integer" },
        "splits": { "type": "integer" },
        "merges": { "type": "integer" }
      }
    },
    "result": { "type": "string" }
  },
  "events": [
    "STREAM_SOURCE_CREATED",
    "LOOP_ITERATION",
    "LOOP_DONE",
    "STREAM_PIPELINE_DECLARED",
    "STREAM_FILTER",
    "STREAM_MAP",
    "STREAM_REDUCE",
    "STREAM_SHORT_CIRCUIT",
    "STREAM_DONE",
    "STREAM_BOXING",
    "PRIMITIVE_STREAM_STEP",
    "PARALLEL_SPLIT",
    "PARALLEL_MERGE"
  ]
}
