{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stopping a Started Thread trace event state",
  "description": "Shape of the state field for cooperative Java thread cancellation events.",
  "type": "object",
  "required": ["name", "controllerThread", "workers", "signals", "history"],
  "properties": {
    "name": { "type": "string" },
    "controllerThread": { "type": "string" },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "state", "started", "workUnits", "joined", "unsafeStopAttempts"],
        "properties": {
          "name": { "type": "string" },
          "state": { "type": "string" },
          "started": { "type": "boolean" },
          "workUnits": { "type": "integer" },
          "joined": { "type": "boolean" },
          "unsafeStopAttempts": { "type": "integer" },
          "waitReason": { "type": "string" },
          "lastObservation": { "type": "string" }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "worker",
          "stopRequested",
          "interruptSignalSent",
          "interruptStatus",
          "interruptedExceptionPending",
          "restoredInterrupt"
        ],
        "properties": {
          "worker": { "type": "string" },
          "stopRequested": { "type": "boolean" },
          "interruptSignalSent": { "type": "boolean" },
          "interruptStatus": { "type": "boolean" },
          "interruptedExceptionPending": { "type": "boolean" },
          "restoredInterrupt": { "type": "boolean" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "target"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "THREAD_STOP_MODEL_CREATED",
    "THREAD_CREATED",
    "THREAD_STARTED",
    "WORKER_STEP",
    "STOP_REQUESTED",
    "STOP_REQUEST_OBSERVED",
    "WORKER_BLOCKED",
    "THREAD_INTERRUPTED",
    "INTERRUPT_OBSERVED",
    "INTERRUPT_STATUS_OBSERVED",
    "INTERRUPT_RESTORED",
    "UNSAFE_STOP_REJECTED",
    "THREAD_EXITED",
    "JOIN_COMPLETED"
  ]
}
