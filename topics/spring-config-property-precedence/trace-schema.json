{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spring Boot property precedence trace event state",
  "description": "Shape of the `state` field for property-source trace events: the ordered ladder of property sources plus the outcome of the current lookup.",
  "type": "object",
  "required": ["activeProfiles", "sources", "stats"],
  "properties": {
    "activeProfiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources": {
      "description": "The ladder, index 0 = highest priority.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "id", "name", "active", "status", "properties"],
        "properties": {
          "rank": { "type": "integer" },
          "id": {
            "type": "string",
            "enum": [
              "test-properties",
              "command-line",
              "application-json",
              "system-properties",
              "system-environment",
              "profile-external",
              "profile-packaged",
              "external",
              "packaged",
              "annotation",
              "defaults"
            ]
          },
          "name": { "type": "string" },
          "profile": { "type": "string" },
          "active": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["idle", "empty", "pending", "miss", "hit", "shadowed", "not-reached", "inactive"]
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "display", "role"],
              "properties": {
                "id": { "type": "string" },
                "display": { "type": "string" },
                "role": { "type": "string", "enum": ["", "winner", "shadowed"] }
              }
            }
          }
        }
      }
    },
    "lookup": {
      "type": ["object", "null"],
      "required": ["key", "done", "found"],
      "properties": {
        "key": { "type": "string" },
        "done": { "type": "boolean" },
        "found": { "type": "boolean" },
        "value": { "type": ["string", "null"] },
        "winner": { "type": "string" },
        "winnerRank": { "type": "integer" },
        "matchedName": { "type": "string" },
        "relaxed": { "type": "boolean" },
        "shadowed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "getenv": {
      "type": ["object", "null"],
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": ["string", "null"] }
      }
    },
    "stats": {
      "type": "object",
      "required": ["lookups", "overrides", "missing"],
      "properties": {
        "lookups": { "type": "integer" },
        "overrides": { "type": "integer" },
        "missing": { "type": "integer" }
      }
    }
  },
  "events": [
    "ENVIRONMENT_READY",
    "SOURCE_ADDED",
    "PROFILE_ACTIVATED",
    "LOOKUP_STARTED",
    "SOURCE_MISS",
    "RELAXED_BINDING",
    "PROPERTY_RESOLVED",
    "PROPERTY_OVERRIDDEN",
    "PROPERTY_MISSING",
    "SYSTEM_GETENV",
    "PRECEDENCE_REPORT"
  ]
}
