{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Method dispatch trace event state",
  "description": "Shape of the `state` field for overriding/overloading trace events.",
  "type": "object",
  "required": ["classes", "variables"],
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "methods"],
        "properties": {
          "name": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "methods": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "staticType", "runtimeType"],
        "properties": {
          "name": { "type": "string" },
          "staticType": { "type": "string" },
          "runtimeType": { "type": "string" }
        }
      }
    },
    "call": {
      "type": ["object", "null"],
      "properties": {
        "site": { "type": "string" },
        "kind": { "type": "string", "enum": ["OVERRIDE", "OVERLOAD"] },
        "binding": { "type": "string", "enum": ["RUNTIME", "COMPILE"] },
        "basis": { "type": "string" },
        "basisType": { "type": "string" },
        "result": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["owner", "signature", "applicable", "chosen"],
            "properties": {
              "owner": { "type": "string" },
              "signature": { "type": "string" },
              "applicable": { "type": "boolean" },
              "chosen": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "events": [
    "DISPATCH_SCENE",
    "DISPATCH_CLASS",
    "DISPATCH_METHOD",
    "DISPATCH_VAR",
    "DISPATCH_OVERRIDE",
    "DISPATCH_OVERLOAD"
  ]
}
