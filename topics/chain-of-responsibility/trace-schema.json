{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chain of Responsibility trace event state",
  "description": "Shape of the `state` field for chain-of-responsibility trace events.",
  "type": "object",
  "required": ["handlers"],
  "properties": {
    "name": { "type": "string" },
    "handlers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "limit", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "limit": { "type": "integer" },
          "status": { "enum": ["idle", "inspecting", "passed", "handled"] }
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["label", "amount", "position", "outcome"],
      "properties": {
        "label": { "type": "string" },
        "amount": { "type": "integer" },
        "position": {
          "type": "integer",
          "description": "index of the handler holding the request; handlers.length if it fell off the end"
        },
        "outcome": { "enum": ["pending", "handled", "unhandled"] }
      }
    }
  },
  "events": [
    "CHAIN_CREATED",
    "HANDLER_ADDED",
    "REQUEST_RECEIVED",
    "HANDLER_INSPECT",
    "HANDLER_PASS",
    "REQUEST_HANDLED",
    "REQUEST_UNHANDLED"
  ]
}
