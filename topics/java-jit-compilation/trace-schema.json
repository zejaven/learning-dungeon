{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JIT compilation trace event state",
  "description": "Shape of the `state` field for Java JIT compilation trace events.",
  "type": "object",
  "required": ["vmName", "compileThreshold", "totalCalls", "phase", "stages", "methods"],
  "properties": {
    "vmName": { "type": "string" },
    "compileThreshold": { "type": "integer" },
    "totalCalls": { "type": "integer" },
    "phase": { "type": "string" },
    "activeMethod": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "active", "ready"],
        "properties": {
          "id": { "type": "string" },
          "active": { "type": "boolean" },
          "ready": { "type": "boolean" }
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "calls",
          "mode",
          "compiled",
          "inlinedMethods",
          "eliminatedAllocations",
          "deoptimizations",
          "assumptions"
        ],
        "properties": {
          "name": { "type": "string" },
          "calls": { "type": "integer" },
          "mode": { "type": "string" },
          "compiled": { "type": "boolean" },
          "inlinedMethods": {
            "type": "array",
            "items": { "type": "string" }
          },
          "eliminatedAllocations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "deoptimizations": { "type": "integer" },
          "assumptions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "events": [
    "JIT_VM_STARTED",
    "JIT_INTERPRET",
    "JIT_PROFILE_HOT",
    "JIT_COMPILE",
    "JIT_OPTIMIZED_CALL",
    "JIT_INLINE",
    "JIT_ESCAPE_ELIMINATION",
    "JIT_DEOPTIMIZE"
  ]
}
