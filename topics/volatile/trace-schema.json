{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Volatile trace event state",
  "description": "Shape of the state field for Java volatile visibility and ordering trace events.",
  "type": "object",
  "required": ["name", "readyVolatile", "variables", "threads", "history"],
  "properties": {
    "name": { "type": "string" },
    "readyVolatile": { "type": "boolean" },
    "lastHappensBefore": { "type": ["string", "null"] },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "value"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "value": { "type": ["integer", "boolean", "string"] }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "dataView", "readyView", "counterView"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "dataView": { "type": "integer" },
          "readyView": { "type": "boolean" },
          "counterView": { "type": "integer" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "action", "target", "value"],
        "properties": {
          "thread": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" },
          "value": { "type": ["integer", "boolean", "string"] }
        }
      }
    }
  },
  "events": [
    "VOLATILE_MODEL_CREATED",
    "PLAIN_DATA_WRITE",
    "PLAIN_DATA_READ",
    "PLAIN_DATA_READ_STALE",
    "VOLATILE_WRITE",
    "VOLATILE_READ",
    "HAPPENS_BEFORE_ESTABLISHED",
    "PLAIN_FLAG_WRITE",
    "PLAIN_FLAG_READ",
    "PLAIN_READ_STALE",
    "EVENTUAL_VISIBILITY",
    "VOLATILE_COUNTER_READ",
    "VOLATILE_COUNTER_WRITE",
    "LOST_UPDATE"
  ]
}
