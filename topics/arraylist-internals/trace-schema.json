{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArrayList internals trace event state",
  "description": "Shape of the state field for the focused ArrayList topic. The state shows the backing array slots, logical size, capacity, and the cost of the last operation.",
  "type": "object",
  "required": ["kind", "name", "capacity", "size", "slots", "lastOp"],
  "properties": {
    "kind": { "type": "string", "enum": ["arraylist"] },
    "name": { "type": "string" },
    "capacity": { "type": "integer" },
    "size": { "type": "integer" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "value"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": ["string", "null"] }
        }
      }
    },
    "lastOp": {
      "type": "object",
      "required": ["cost", "costKind"],
      "properties": {
        "cost": {
          "type": "integer",
          "description": "How many elements the last operation had to copy or shift."
        },
        "costKind": {
          "type": "string",
          "enum": ["none", "direct", "shifts", "copies"]
        }
      }
    }
  },
  "events": [
    "ARRAYLIST_CREATED",
    "ARRAYLIST_ADD",
    "ARRAYLIST_GET",
    "ARRAYLIST_INSERT",
    "ARRAYLIST_REMOVE",
    "ARRAYLIST_GROW"
  ]
}
