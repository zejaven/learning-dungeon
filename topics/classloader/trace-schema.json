{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClassLoader trace event state",
  "description": "Shape of the `state` field for ClassLoader trace events.",
  "type": "object",
  "required": ["loaders"],
  "properties": {
    "requested": { "type": ["string", "null"] },
    "active": { "type": ["string", "null"] },
    "phase": { "type": "string" },
    "loaders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level", "knows", "loaded"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "integer" },
          "knows": { "type": "array", "items": { "type": "string" } },
          "loaded": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "events": [
    "CLASSLOADER_CREATED",
    "LOAD_REQUEST",
    "DELEGATE_UP",
    "ALREADY_LOADED",
    "CLASS_DEFINED",
    "CLASS_NOT_FOUND"
  ]
}
