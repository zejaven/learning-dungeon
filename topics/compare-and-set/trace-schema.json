{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compare-and-set trace event state",
  "description": "Shape of the state field for compare-and-set trace events.",
  "type": "object",
  "required": ["name", "value", "revision", "threads", "history"],
  "properties": {
    "name": { "type": "string" },
    "value": { "type": "integer" },
    "revision": { "type": "integer" },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "attempts"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "attempts": { "type": "integer" },
          "lastRead": { "type": "integer" },
          "lastReadRevision": { "type": "integer" },
          "lastExpected": { "type": "integer" },
          "lastUpdate": { "type": "integer" },
          "lastResult": { "type": "string" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "action", "before", "after", "revision"],
        "properties": {
          "thread": { "type": "string" },
          "action": { "type": "string" },
          "before": { "type": "integer" },
          "expected": { "type": "integer" },
          "update": { "type": "integer" },
          "after": { "type": "integer" },
          "result": { "type": "string" },
          "revision": { "type": "integer" }
        }
      }
    }
  },
  "events": [
    "CAS_CREATED",
    "CAS_READ",
    "CAS_SUCCESS",
    "CAS_FAILURE",
    "CAS_RETRY",
    "CAS_ABA_RISK"
  ]
}
