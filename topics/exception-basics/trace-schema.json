{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exception trace event state",
  "description": "Shape of the `state` field for exception trace events.",
  "type": "object",
  "required": ["stack"],
  "properties": {
    "stack": {
      "type": "array",
      "description": "Call stack, bottom (first call) to top (current frame).",
      "items": {
        "type": "object",
        "required": ["method", "hasFinally"],
        "properties": {
          "method": { "type": "string" },
          "catches": { "type": ["string", "null"] },
          "hasFinally": { "type": "boolean" }
        }
      }
    },
    "exception": {
      "type": ["object", "null"],
      "required": ["type", "category", "status"],
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string", "enum": ["ERROR", "CHECKED", "UNCHECKED"] },
        "status": { "type": "string", "enum": ["in-flight", "caught", "uncaught", "info"] }
      }
    }
  },
  "events": [
    "EXCEPTION_SCENE",
    "STACK_PUSH",
    "THROW",
    "PROPAGATE",
    "CATCH",
    "FINALLY",
    "UNCAUGHT",
    "TYPE_INFO"
  ]
}
