{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JVM heap generations trace event state",
  "description": "Shape of the `state` field for heap-generations trace events.",
  "type": "object",
  "required": ["regions"],
  "properties": {
    "name": { "type": "string" },
    "tenuringThreshold": { "type": "integer" },
    "minorGcCount": { "type": "integer" },
    "majorGcCount": { "type": "integer" },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "objects"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "kind": { "enum": ["eden", "survivor", "old"] },
          "capacity": { "type": "integer", "description": "-1 means unbounded (Old)" },
          "active": { "type": "boolean", "description": "survivor currently holding live objects" },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "age", "dead"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "age": { "type": "integer" },
                "dead": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  },
  "events": [
    "HEAP_CREATED",
    "OBJECT_ALLOCATED",
    "OBJECT_UNREACHABLE",
    "EDEN_FULL",
    "MINOR_GC",
    "PROMOTION",
    "MAJOR_GC"
  ]
}
