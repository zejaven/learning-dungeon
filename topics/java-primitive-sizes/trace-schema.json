{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Java primitive sizes trace event state",
  "description": "Shape of the state field for java-primitive-sizes trace events: the primitive byte-size table plus the current focus.",
  "type": "object",
  "required": ["focus", "rows"],
  "properties": {
    "focus": {
      "type": "string",
      "enum": ["table", "integer", "floating", "char", "boolean", "storage"]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "family", "bits", "bytes", "storage", "range"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["byte", "short", "int", "long", "float", "double", "char", "boolean"]
          },
          "family": {
            "type": "string",
            "enum": ["integer", "floating", "character", "logical"]
          },
          "bits": {
            "type": ["integer", "null"],
            "description": "Value width in bits when Java defines it. null for boolean because portable byte storage is not specified."
          },
          "bytes": {
            "type": ["integer", "null"],
            "description": "Value width in bytes when Java defines it. null for boolean because portable byte storage is not specified."
          },
          "storage": {
            "type": "string",
            "enum": ["fixed", "not-specified"]
          },
          "range": {
            "type": "string"
          }
        }
      }
    }
  },
  "events": [
    "PRIMITIVE_SIZE_TABLE",
    "PRIMITIVE_INTEGRAL_SIZES",
    "PRIMITIVE_FLOATING_SIZES",
    "PRIMITIVE_CHAR_SIZE",
    "PRIMITIVE_BOOLEAN_CAVEAT",
    "PRIMITIVE_STORAGE_CONTEXT"
  ]
}
