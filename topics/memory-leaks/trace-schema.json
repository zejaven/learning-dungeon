{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory leak trace event state",
  "description": "Shape of the state field for Java memory-leak trace events: GC roots, heap objects, and recent actions.",
  "type": "object",
  "required": ["name", "liveCount", "leakCount", "roots", "objects", "history"],
  "properties": {
    "name": { "type": "string" },
    "liveCount": { "type": "integer" },
    "leakCount": { "type": "integer" },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "holders", "collected", "leaked", "escaped"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "holders": { "type": "array", "items": { "type": "string" } },
          "collected": { "type": "boolean" },
          "leaked": { "type": "boolean" },
          "escaped": { "type": "boolean" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "target", "detail"],
        "properties": {
          "action": { "type": "string" },
          "target": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "MODEL_CREATED",
    "ROOT_DECLARED",
    "ALLOCATE",
    "REFERENCE_ADDED",
    "REFERENCE_REMOVED",
    "SCOPE_EXIT",
    "GC_RUN",
    "GC_COLLECTED",
    "LEAK_DETECTED"
  ]
}
