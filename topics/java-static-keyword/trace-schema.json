{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Java static trace event state",
  "description": "Shape of the `state` field for Java static keyword trace events.",
  "type": "object",
  "required": [
    "className",
    "initialized",
    "initializationCount",
    "staticFields",
    "instances",
    "calls",
    "nestedClasses"
  ],
  "properties": {
    "className": { "type": "string" },
    "initialized": { "type": "boolean" },
    "initializationCount": { "type": "integer" },
    "staticFields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "constant"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "constant": { "type": "boolean" }
        }
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "fields"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "receiver", "method", "note"],
        "properties": {
          "target": { "type": "string", "enum": ["class", "object"] },
          "receiver": { "type": "string" },
          "method": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "nestedClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "note"],
        "properties": {
          "name": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "STATIC_SCENE",
    "STATIC_CLASS_INIT",
    "STATIC_CLASS_ALREADY_INIT",
    "STATIC_FIELD_WRITE",
    "STATIC_CONSTANT",
    "INSTANCE_CREATED",
    "INSTANCE_FIELD_WRITE",
    "STATIC_METHOD_CALL",
    "INSTANCE_METHOD_CALL",
    "STATIC_NESTED_CLASS"
  ]
}
