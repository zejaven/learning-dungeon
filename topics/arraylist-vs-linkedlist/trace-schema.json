{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArrayList vs LinkedList trace event state",
  "description": "Shape of the `state` field. The `kind` discriminator selects which collection is being shown: an ArrayList (backing array of slots) or a LinkedList (chain of nodes). Both report the cost of the last operation.",
  "type": "object",
  "required": ["kind", "size", "lastOp"],
  "properties": {
    "kind": { "type": "string", "enum": ["arraylist", "linkedlist"] },
    "name": { "type": "string" },
    "size": { "type": "integer" },
    "capacity": {
      "type": "integer",
      "description": "ArrayList only: length of the backing array."
    },
    "slots": {
      "type": "array",
      "description": "ArrayList only: every slot of the backing array.",
      "items": {
        "type": "object",
        "required": ["index", "value"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": ["string", "null"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "description": "LinkedList only: nodes in head-to-tail order.",
      "items": {
        "type": "object",
        "required": ["index", "value"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": "string" }
        }
      }
    },
    "lastOp": {
      "type": "object",
      "required": ["cost", "costKind"],
      "properties": {
        "cost": {
          "type": "integer",
          "description": "How many elements the last operation had to touch."
        },
        "costKind": {
          "type": "string",
          "enum": ["none", "direct", "shifts", "copies", "hops"]
        }
      }
    }
  },
  "events": [
    "ARRAYLIST_CREATED",
    "ARRAYLIST_ADD",
    "ARRAYLIST_GET",
    "ARRAYLIST_INSERT",
    "ARRAYLIST_REMOVE",
    "ARRAYLIST_GROW",
    "LINKEDLIST_CREATED",
    "LINKEDLIST_ADD",
    "LINKEDLIST_GET",
    "LINKEDLIST_INSERT"
  ]
}
