{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exceptions and OutOfMemoryError trace state",
  "description": "Exception stack state with optional deterministic heap-budget state.",
  "type": "object",
  "required": ["stack"],
  "properties": {
    "stack": {
      "type": "array",
      "description": "Call stack, bottom (first call) to top (current frame).",
      "items": {
        "type": "object",
        "required": ["method", "hasFinally"],
        "properties": {
          "method": { "type": "string" },
          "catches": { "type": ["string", "null"] },
          "hasFinally": { "type": "boolean" }
        }
      }
    },
    "exception": {
      "type": ["object", "null"],
      "required": ["type", "category", "status"],
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string", "enum": ["ERROR", "CHECKED", "UNCHECKED"] },
        "status": { "type": "string", "enum": ["in-flight", "caught", "uncaught", "info"] }
      }
    },
    "memory": {
      "type": "object",
      "required": ["limitMb", "usedMb", "freeMb", "phase", "allocations"],
      "properties": {
        "limitMb": { "type": "integer" },
        "usedMb": { "type": "integer" },
        "freeMb": { "type": "integer" },
        "phase": {
          "type": "string",
          "enum": ["normal", "pressure", "exhausted", "recovering", "failed"]
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "megabytes", "kind", "retained"],
            "properties": {
              "name": { "type": "string" },
              "megabytes": { "type": "integer" },
              "kind": { "type": "string", "enum": ["essential", "cache"] },
              "retained": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "events": [
    "EXCEPTION_SCENE",
    "STACK_PUSH",
    "THROW",
    "PROPAGATE",
    "CATCH",
    "FINALLY",
    "UNCAUGHT",
    "TYPE_INFO",
    "MEMORY_BASELINE",
    "MEMORY_ALLOCATE",
    "MEMORY_PRESSURE",
    "OUT_OF_MEMORY",
    "CACHE_RELEASED",
    "FAIL_FAST"
  ]
}
