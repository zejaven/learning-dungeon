{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StackOverflowError fewer-calls trace event state",
  "description": "Shape of the state field for a stack byte-budget simulation: one thread stack, frames with byte sizes, optional heap objects, and a failed frame attempt when the budget is exceeded.",
  "type": "object",
  "required": ["stackBytes", "usedBytes", "remainingBytes", "overflowed", "frames", "heapObjects", "attempt"],
  "properties": {
    "stackBytes": {
      "type": "integer",
      "description": "Total simulated stack budget in bytes."
    },
    "usedBytes": {
      "type": "integer",
      "description": "Bytes currently occupied by active stack frames."
    },
    "remainingBytes": {
      "type": "integer",
      "description": "Bytes still available before overflow."
    },
    "overflowed": {
      "type": "boolean",
      "description": "True once a frame no longer fits and StackOverflowError would be thrown."
    },
    "frames": {
      "type": "array",
      "description": "The current call stack, bottom frame first.",
      "items": {
        "type": "object",
        "required": ["depth", "name", "bytes", "locals"],
        "properties": {
          "depth": { "type": "integer" },
          "name": { "type": "string" },
          "bytes": { "type": "integer" },
          "locals": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "heapObjects": {
      "type": "array",
      "description": "Objects modeled outside the stack frames.",
      "items": {
        "type": "object",
        "required": ["id", "label", "bytes"],
        "properties": {
          "id": { "type": "integer" },
          "label": { "type": "string" },
          "bytes": { "type": "integer" }
        }
      }
    },
    "attempt": {
      "type": ["object", "null"],
      "description": "The frame attempted by the current call, present on overflow.",
      "properties": {
        "name": { "type": "string" },
        "bytes": { "type": "integer" },
        "locals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fits": { "type": "boolean" }
      }
    }
  },
  "events": [
    "STACK_BUDGET_SCENE",
    "STACK_FRAME_PUSH",
    "STACK_FRAME_POP",
    "STACK_FRAME_OVERFLOW",
    "HEAP_OBJECT_ALLOCATED"
  ]
}
