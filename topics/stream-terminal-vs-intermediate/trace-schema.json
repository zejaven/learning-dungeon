{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stream pipeline trace event state",
  "description": "Shape of the `state` field for Stream intermediate/terminal trace events.",
  "type": "object",
  "required": ["name", "phase", "source", "stages"],
  "properties": {
    "name": { "type": "string" },
    "phase": { "type": "string", "enum": ["building", "running", "done"] },
    "consumed": { "type": "boolean" },
    "shortCircuited": { "type": "boolean" },
    "source": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "status"],
        "properties": {
          "value": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "active", "used", "skipped"]
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "kind", "op", "active"],
        "properties": {
          "label": { "type": "string" },
          "kind": { "type": "string", "enum": ["intermediate", "terminal"] },
          "op": { "type": "string" },
          "active": { "type": "boolean" }
        }
      }
    },
    "current": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": "string" },
        "stageIndex": { "type": "integer" }
      }
    },
    "output": {
      "type": "array",
      "items": { "type": "string" }
    },
    "result": { "type": ["string", "null"] }
  },
  "events": [
    "STREAM_SOURCE",
    "STREAM_PIPELINE_OP",
    "STREAM_TERMINAL_START",
    "STREAM_ELEMENT_IN",
    "STREAM_MAP",
    "STREAM_FILTER_PASS",
    "STREAM_FILTER_DROP",
    "STREAM_ELEMENT_COLLECTED",
    "STREAM_SHORT_CIRCUIT",
    "STREAM_TERMINAL_RESULT",
    "STREAM_CONSUMED"
  ]
}
