{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lock alternatives trace event state",
  "description": "Shape of the state field for ReentrantLock, ReadWriteLock and StampedLock teaching traces.",
  "type": "object",
  "required": [
    "name",
    "kind",
    "policy",
    "readers",
    "waitingQueue",
    "version",
    "optimisticReads",
    "history"
  ],
  "properties": {
    "name": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["REENTRANT_LOCK", "READ_WRITE_LOCK", "STAMPED_LOCK"]
    },
    "policy": { "type": "string" },
    "owner": { "type": ["string", "null"] },
    "holdCount": { "type": "integer" },
    "readers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "holds"],
        "properties": {
          "thread": { "type": "string" },
          "holds": { "type": "integer" }
        }
      }
    },
    "writer": { "type": ["string", "null"] },
    "waitingQueue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "mode"],
        "properties": {
          "thread": { "type": "string" },
          "mode": { "type": "string", "enum": ["READ", "WRITE"] }
        }
      }
    },
    "version": { "type": "integer" },
    "optimisticReads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "stamp", "valid"],
        "properties": {
          "thread": { "type": "string" },
          "stamp": { "type": "integer" },
          "valid": { "type": "boolean" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "detail"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "LOCK_CREATED",
    "REENTRANT_LOCK_ACQUIRED",
    "REENTRANT_LOCK_REENTERED",
    "REENTRANT_TRY_LOCK_FAILED",
    "REENTRANT_LOCK_WAITING",
    "REENTRANT_LOCK_RELEASED",
    "REENTRANT_LOCK_GRANTED",
    "READWRITE_READ_SHARED",
    "READWRITE_READ_WAITING",
    "READWRITE_WRITE_WAITING",
    "READWRITE_WRITE_ACQUIRED",
    "READWRITE_LOCK_RELEASED",
    "READWRITE_UPGRADE_RISK",
    "STAMPED_OPTIMISTIC_READ",
    "STAMPED_VALIDATE_OK",
    "STAMPED_VALIDATE_FAILED",
    "STAMPED_READ_LOCK",
    "STAMPED_READ_WAITING",
    "STAMPED_WRITE_LOCK",
    "STAMPED_WRITE_WAITING",
    "STAMPED_CONVERT_TO_WRITE",
    "STAMPED_CONVERT_FAILED",
    "STAMPED_UNLOCK_READ",
    "STAMPED_UNLOCK_WRITE"
  ]
}
