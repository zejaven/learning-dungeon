{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConcurrentHashMap vs synchronized HashMap trace event state",
  "description": "Shape of the state field for the lock-granularity trace events.",
  "type": "object",
  "required": [
    "name",
    "kind",
    "strategy",
    "capacity",
    "waitingQueue",
    "bins",
    "threads",
    "history"
  ],
  "properties": {
    "name": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["SYNCHRONIZED_MAP", "CONCURRENT_HASH_MAP"]
    },
    "strategy": { "type": "string" },
    "capacity": { "type": "integer" },
    "mapLockOwner": { "type": ["string", "null"] },
    "waitingQueue": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "entries"],
        "properties": {
          "index": { "type": "integer" },
          "lockOwner": { "type": ["string", "null"] },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value"],
              "properties": {
                "key": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "operation": { "type": "string" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "action"],
        "properties": {
          "thread": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "MAP_CREATED",
    "SYNC_LOCK_ACQUIRED",
    "SYNC_BLOCKED",
    "SYNC_PUT",
    "SYNC_GET",
    "SYNC_LOCK_RELEASED",
    "CHM_BIN_LOCK_ACQUIRED",
    "CHM_BIN_BLOCKED",
    "CHM_PUT",
    "CHM_BIN_LOCK_RELEASED",
    "CHM_GET",
    "CHM_ATOMIC"
  ]
}
