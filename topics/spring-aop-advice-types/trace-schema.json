{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spring AOP advice type trace event state",
  "description": "Shape of the state field for Spring AOP advice timing events.",
  "type": "object",
  "required": [
    "target",
    "proxy",
    "activeMethod",
    "callMode",
    "phase",
    "pointcutMatched",
    "advices",
    "stack",
    "businessMethods",
    "executed"
  ],
  "properties": {
    "target": { "type": "string" },
    "proxy": { "type": "string" },
    "activeMethod": { "type": "string" },
    "callMode": {
      "type": "string",
      "enum": ["none", "proxy", "direct"]
    },
    "phase": {
      "type": "string",
      "enum": [
        "idle",
        "duplication",
        "setup",
        "proxy",
        "direct",
        "pointcut",
        "around",
        "before",
        "target",
        "after",
        "afterReturning",
        "exception",
        "afterThrowing",
        "done"
      ]
    },
    "pointcutMatched": { "type": "boolean" },
    "advices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "pointcut", "applied"],
        "properties": {
          "name": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["before", "after", "afterReturning", "afterThrowing", "around"]
          },
          "pointcut": { "type": "string" },
          "applied": { "type": "boolean" }
        }
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["proxy", "advice", "target"]
          }
        }
      }
    },
    "businessMethods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "concerns"],
        "properties": {
          "name": { "type": "string" },
          "concerns": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "executed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "name", "method", "action"],
        "properties": {
          "id": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["proxy", "advice", "target"]
          },
          "name": { "type": "string" },
          "method": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "AOP_PROXY_CREATED",
    "AOP_DUPLICATION_FOUND",
    "AOP_ADVICE_REGISTERED",
    "AOP_PROXY_INTERCEPT",
    "AOP_POINTCUT_MATCH",
    "AOP_POINTCUT_MISS",
    "AOP_ADVICE_BEFORE",
    "AOP_ADVICE_AROUND_START",
    "AOP_TARGET_CALL",
    "AOP_ADVICE_AFTER_RETURNING",
    "AOP_EXCEPTION",
    "AOP_ADVICE_AFTER_THROWING",
    "AOP_ADVICE_AFTER",
    "AOP_ADVICE_AROUND_FINISH",
    "AOP_DIRECT_CALL",
    "AOP_RETURN"
  ]
}
