{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArrayList index addressing trace event state",
  "description": "Shape of the state field for the index-to-address topic. The state shows the contiguous backing array of reference slots, each slot's computed address and the reference it holds, and the arithmetic of the last access.",
  "type": "object",
  "required": ["kind", "name", "base", "header", "scale", "size", "capacity", "slots", "lastOp"],
  "properties": {
    "kind": { "type": "string", "enum": ["array-indexing"] },
    "name": { "type": "string" },
    "base": { "type": "string", "description": "Base address of the backing array (hex)." },
    "header": { "type": "integer", "description": "Bytes of array header before element [0]." },
    "scale": { "type": "integer", "description": "Bytes per reference slot." },
    "size": { "type": "integer" },
    "capacity": { "type": "integer" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "address", "ref", "value"],
        "properties": {
          "index": { "type": "integer" },
          "address": { "type": "string", "description": "Computed slot address (hex)." },
          "ref": { "type": ["string", "null"], "description": "Heap pointer held in the slot (hex), or null if empty." },
          "value": { "type": ["string", "null"], "description": "Displayed content of the referenced object, or null if empty." }
        }
      }
    },
    "lastOp": {
      "type": ["object", "null"],
      "required": ["kind", "index"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["store", "bounds", "address", "read", "oob"]
        },
        "index": { "type": "integer" },
        "formula": { "type": ["string", "null"], "description": "base + header + index * scale = address." },
        "address": { "type": ["string", "null"] }
      }
    }
  },
  "events": [
    "ARRAY_INDEX_CREATED",
    "ARRAY_STORE_REF",
    "ARRAY_BOUNDS_CHECK",
    "ARRAY_ADDRESS_CALC",
    "ARRAY_READ_REF",
    "ARRAY_OUT_OF_BOUNDS"
  ]
}
