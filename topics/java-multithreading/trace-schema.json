{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Java multithreading trace event state",
  "description": "Shape of the state field for Java multithreading trace events.",
  "type": "object",
  "required": ["name", "currentThread", "runnables", "threads", "history"],
  "properties": {
    "name": { "type": "string" },
    "currentThread": { "type": "string" },
    "runnables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "state", "attachedTo", "runs"],
        "properties": {
          "name": { "type": "string" },
          "state": { "type": "string" },
          "attachedTo": {
            "type": "array",
            "items": { "type": "string" }
          },
          "runs": { "type": "integer" }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "state", "kind", "task", "started"],
        "properties": {
          "name": { "type": "string" },
          "state": { "type": "string" },
          "kind": { "type": "string" },
          "task": { "type": "string" },
          "started": { "type": "boolean" },
          "executionThread": { "type": "string" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "target"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "THREAD_MODEL_CREATED",
    "RUNNABLE_CREATED",
    "THREAD_CREATED_WITH_RUNNABLE",
    "RUNNABLE_REUSED",
    "THREAD_SUBCLASS_CREATED",
    "THREAD_STARTED",
    "RUNNABLE_EXECUTED",
    "THREAD_RUN_EXECUTED",
    "THREAD_RUN_CALLED_DIRECTLY",
    "THREAD_TERMINATED"
  ]
}
