{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "equals/hashCode contract trace event state",
  "description": "Shape of the state field for equals/hashCode contract trace events.",
  "type": "object",
  "required": ["name", "capacity", "size", "lastOp", "buckets"],
  "properties": {
    "name": { "type": "string" },
    "capacity": { "type": "integer" },
    "size": { "type": "integer" },
    "lastOp": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "left": { "type": "string" },
        "right": { "type": "string" },
        "value": { "type": "string" },
        "equal": { "type": "boolean" },
        "leftEqualsRight": { "type": "boolean" },
        "rightEqualsLeft": { "type": "boolean" },
        "leftHash": { "type": "integer" },
        "rightHash": { "type": "integer" },
        "hashesMatch": { "type": "boolean" },
        "hash": { "type": "integer" },
        "bucket": { "type": "integer" },
        "result": { "type": "string" }
      }
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "nodes"],
        "properties": {
          "index": { "type": "integer" },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "storedHash", "currentHash", "storedBucket"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "storedHash": { "type": "integer" },
                "currentHash": { "type": "integer" },
                "storedBucket": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  },
  "events": [
    "EQUALITY_CREATED",
    "EQUALITY_COMPARE",
    "EQUALITY_CONTRACT_OK",
    "EQUALITY_CONTRACT_BROKEN",
    "EQUALITY_SYMMETRY_OK",
    "EQUALITY_SYMMETRY_BROKEN",
    "EQUALITY_SET_ADD",
    "EQUALITY_HASH_COLLISION",
    "EQUALITY_DUPLICATE_REJECTED",
    "EQUALITY_DUPLICATE_STORED",
    "EQUALITY_SET_CONTAINS",
    "EQUALITY_SET_MISS",
    "EQUALITY_LOOKUP_MISSED"
  ]
}
