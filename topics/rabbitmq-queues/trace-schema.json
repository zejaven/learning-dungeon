{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message broker (RabbitMQ-style) trace event state",
  "description": "Shape of the `state` field for rabbitmq-queues trace events.",
  "type": "object",
  "required": ["exchanges", "queues", "consumers", "stats"],
  "properties": {
    "exchanges": {
      "type": "array",
      "description": "Declared exchanges, in declaration order.",
      "items": {
        "type": "object",
        "required": ["name", "type", "bindings"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["direct", "fanout", "topic"] },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["queue", "key"],
              "properties": {
                "queue": { "type": "string" },
                "key": {
                  "type": "string",
                  "description": "Binding key; empty for fanout bindings."
                }
              }
            }
          }
        }
      }
    },
    "queues": {
      "type": "array",
      "description": "Declared queues with their ready (not yet delivered) messages, head first.",
      "items": {
        "type": "object",
        "required": ["name", "deadLetterQueue", "messages"],
        "properties": {
          "name": { "type": "string" },
          "deadLetterQueue": {
            "type": "string",
            "description": "Dead-letter target; empty when the queue has none."
          },
          "messages": { "$ref": "#/definitions/messages" }
        }
      }
    },
    "consumers": {
      "type": "array",
      "description": "Attached consumers and the messages they hold unacknowledged.",
      "items": {
        "type": "object",
        "required": ["name", "queue", "prefetch", "unacked"],
        "properties": {
          "name": { "type": "string" },
          "queue": { "type": "string" },
          "prefetch": { "type": "integer" },
          "unacked": { "$ref": "#/definitions/messages" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["published", "delivered", "acked", "requeued", "deadLettered", "dropped"],
      "properties": {
        "published": { "type": "integer" },
        "delivered": { "type": "integer" },
        "acked": { "type": "integer" },
        "requeued": { "type": "integer" },
        "deadLettered": { "type": "integer" },
        "dropped": {
          "type": "integer",
          "description": "Unroutable messages plus rejections with no dead-letter target."
        }
      }
    },
    "flight": {
      "type": "object",
      "description": "The message currently moving through the broker (absent on topology events).",
      "required": ["id", "payload", "stage"],
      "properties": {
        "id": { "type": "string" },
        "payload": { "type": "string" },
        "stage": {
          "enum": [
            "published",
            "routed",
            "unroutable",
            "delivered",
            "redelivered",
            "waiting",
            "acked",
            "requeued",
            "dead-lettered",
            "dropped"
          ]
        },
        "exchange": { "type": "string" },
        "routingKey": { "type": "string" },
        "queue": { "type": "string" },
        "consumer": { "type": "string" }
      }
    }
  },
  "definitions": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "payload", "redelivered"],
        "properties": {
          "id": { "type": "string" },
          "payload": { "type": "string" },
          "redelivered": { "type": "boolean" }
        }
      }
    }
  },
  "events": [
    "BROKER_CREATED",
    "EXCHANGE_DECLARED",
    "QUEUE_DECLARED",
    "QUEUE_BOUND",
    "CONSUMER_ATTACHED",
    "MESSAGE_PUBLISHED",
    "MESSAGE_ROUTED",
    "MESSAGE_UNROUTABLE",
    "MESSAGE_DELIVERED",
    "PREFETCH_BLOCKED",
    "MESSAGE_ACKED",
    "MESSAGE_REQUEUED",
    "MESSAGE_DEAD_LETTERED",
    "MESSAGE_DROPPED",
    "CONSUMER_CRASHED"
  ]
}
