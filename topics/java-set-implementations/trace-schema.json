{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Set implementation comparison trace event state",
  "description": "Shape of the `state` field for side-by-side HashSet, LinkedHashSet and TreeSet trace events.",
  "type": "object",
  "required": ["name", "operation", "noteEn", "noteRu", "implementations"],
  "properties": {
    "name": { "type": "string" },
    "operation": { "type": "string" },
    "probe": { "type": ["string", "null"] },
    "noteEn": { "type": "string" },
    "noteRu": { "type": "string" },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "structureEn",
          "structureRu",
          "orderEn",
          "orderRu",
          "uniquenessEn",
          "uniquenessRu",
          "costEn",
          "costRu",
          "size",
          "values",
          "lastResult"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "structureEn": { "type": "string" },
          "structureRu": { "type": "string" },
          "orderEn": { "type": "string" },
          "orderRu": { "type": "string" },
          "uniquenessEn": { "type": "string" },
          "uniquenessRu": { "type": "string" },
          "costEn": { "type": "string" },
          "costRu": { "type": "string" },
          "size": { "type": "integer" },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "value"],
              "properties": {
                "index": { "type": "integer" },
                "value": { "type": "string" }
              }
            }
          },
          "lastResult": {
            "type": "object",
            "required": ["status", "detailEn", "detailRu"],
            "properties": {
              "status": { "type": "string" },
              "detailEn": { "type": "string" },
              "detailRu": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "events": [
    "SETS_CREATED",
    "SET_ADD",
    "SET_DUPLICATE",
    "SET_TREESET_COMPARATOR_DUPLICATE",
    "SET_NULL_POLICY",
    "SET_TREESET_REJECTED",
    "SET_CONTAINS",
    "SET_REMOVE",
    "SET_ITERATION_ORDER"
  ]
}
