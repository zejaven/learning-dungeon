{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Red-black tree trace event state",
  "description": "Shape of the `state` field for red-black tree insertion, balancing, and search events.",
  "type": "object",
  "required": ["name", "size", "height", "blackHeight", "root", "inOrder", "lastOp"],
  "properties": {
    "name": { "type": "string" },
    "size": { "type": "integer" },
    "height": { "type": "integer" },
    "blackHeight": { "type": "integer" },
    "root": {
      "type": ["object", "null"],
      "required": ["id", "key", "color"],
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "integer" },
        "color": { "type": "string", "enum": ["R", "B"] },
        "left": { "type": ["object", "null"] },
        "right": { "type": ["object", "null"] }
      }
    },
    "inOrder": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "key", "color"],
        "properties": {
          "index": { "type": "integer" },
          "key": { "type": "integer" },
          "color": { "type": "string", "enum": ["R", "B"] }
        }
      }
    },
    "lastOp": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "type": "string" },
        "key": { "type": ["integer", "null"] },
        "result": { "type": ["string", "null"] },
        "path": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    }
  },
  "events": [
    "RBT_CREATED",
    "RBT_INSERT",
    "RBT_DUPLICATE",
    "RBT_RECOLOR",
    "RBT_ROOT_BLACK",
    "RBT_ROTATE_LEFT",
    "RBT_ROTATE_RIGHT",
    "RBT_SEARCH"
  ]
}
