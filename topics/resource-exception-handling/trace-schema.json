{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resource exception handling trace event state",
  "description": "Shape of the `state` field for resource exception handling trace events.",
  "type": "object",
  "required": ["phase", "resources", "closeSequence", "suppressedExceptions"],
  "properties": {
    "phase": { "type": "string" },
    "primaryException": { "type": ["string", "null"] },
    "caughtException": { "type": ["string", "null"] },
    "suppressedExceptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "closeSequence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "openOrder", "closeFails", "lastAction"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "openOrder": { "type": "integer" },
          "closeOrder": { "type": ["integer", "null"] },
          "closeFails": { "type": "boolean" },
          "lastAction": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "RESOURCE_OPENED",
    "RESOURCE_USED",
    "RESOURCE_CLOSED",
    "RESOURCE_REVERSE_CLOSE",
    "RESOURCE_PRIMARY_EXCEPTION",
    "RESOURCE_CLOSE_FAILED",
    "RESOURCE_CAUGHT_EXCEPTION",
    "RESOURCE_SUPPRESSED_EXCEPTION",
    "RESOURCE_FINALLY"
  ]
}
