{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JVM source-to-runtime trace event state",
  "description": "Shape of the `state` field for JVM source code pipeline trace events.",
  "type": "object",
  "required": ["className", "sourceFile", "bytecodeFile", "currentStage", "stages", "artifacts", "memory"],
  "properties": {
    "className": { "type": "string" },
    "sourceFile": { "type": "string" },
    "bytecodeFile": { "type": "string" },
    "currentStage": { "type": "string" },
    "activeMethod": { "type": "string" },
    "hotMethod": { "type": "string" },
    "hotCalls": { "type": "integer" },
    "jitThreshold": { "type": "integer" },
    "nativeCompiled": { "type": "boolean" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "kind": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "items"],
        "properties": {
          "area": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "output": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "events": [
    "JVM_SOURCE_CREATED",
    "JVM_SOURCE_REJECTED",
    "JAVAC_COMPILED",
    "BYTECODE_LOADED",
    "BYTECODE_VERIFIED",
    "CLASS_INITIALIZED",
    "BYTECODE_INTERPRETED",
    "METHOD_JIT_COMPILED",
    "OBJECT_ALLOCATED",
    "PROGRAM_OUTPUT"
  ]
}
