{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "String immutability trace event state",
  "description": "Shape of the `state` field for string-immutability trace events.",
  "type": "object",
  "required": ["variables", "objects"],
  "properties": {
    "variables": {
      "type": "array",
      "description": "Named references (the 'stack').",
      "items": {
        "type": "object",
        "required": ["name", "ref"],
        "properties": {
          "name": { "type": "string" },
          "ref": { "type": ["string", "null"], "description": "id of the heap object referenced, or null" }
        }
      }
    },
    "objects": {
      "type": "array",
      "description": "Heap objects, in allocation order.",
      "items": {
        "type": "object",
        "required": ["id", "type", "value", "pooled", "referenced"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["String", "byte[]", "StringBuilder"] },
          "value": { "type": "string" },
          "backing": { "type": ["string", "null"], "description": "id of the backing byte[] (for a String)" },
          "pooled": { "type": "boolean", "description": "kept alive by the string pool" },
          "referenced": { "type": "boolean", "description": "reachable from a variable or the pool; false = garbage" }
        }
      }
    },
    "pool": {
      "type": "array",
      "description": "ids of String objects currently interned in the pool.",
      "items": { "type": "string" }
    }
  },
  "events": [
    "STRING_SCENE",
    "STRING_LITERAL",
    "STRING_NEW",
    "STRING_DERIVE",
    "STRING_INTERN",
    "STRING_COMPARE",
    "BUILDER_NEW",
    "BUILDER_APPEND"
  ]
}
