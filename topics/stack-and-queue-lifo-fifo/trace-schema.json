{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stack and Queue trace event state",
  "description": "Shape of the `state` field for Stack and Queue trace events.",
  "type": "object",
  "required": ["kind", "name", "structure", "size", "items", "leftEnd", "rightEnd", "lastOperation"],
  "properties": {
    "kind": { "type": "string", "const": "stackQueue" },
    "name": { "type": "string" },
    "structure": { "type": "string", "enum": ["stack", "queue"] },
    "size": { "type": "integer" },
    "leftEnd": { "type": "string", "enum": ["bottom", "front"] },
    "rightEnd": { "type": "string", "enum": ["top", "back"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "value", "role"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": "string" },
          "role": { "type": "string", "enum": ["bottom", "top", "front", "back", "middle"] }
        }
      }
    },
    "lastOperation": {
      "type": "object",
      "required": ["method", "rule", "cost"],
      "properties": {
        "method": { "type": "string" },
        "result": { "type": ["string", "null"] },
        "rule": { "type": "string", "enum": ["CREATE", "LIFO", "FIFO", "PEEK", "EMPTY"] },
        "cost": { "type": "string" }
      }
    }
  },
  "events": [
    "STACK_CREATED",
    "STACK_PUSH",
    "STACK_POP",
    "STACK_POP_EMPTY",
    "STACK_PEEK",
    "STACK_PEEK_EMPTY",
    "QUEUE_CREATED",
    "QUEUE_OFFER",
    "QUEUE_POLL",
    "QUEUE_POLL_EMPTY",
    "QUEUE_PEEK",
    "QUEUE_PEEK_EMPTY"
  ]
}
