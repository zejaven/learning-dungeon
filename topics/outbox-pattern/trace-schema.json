{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Outbox pattern trace event state",
  "description": "Shape of the `state` field for outbox-pattern trace events.",
  "type": "object",
  "required": ["orders", "outbox", "broker", "committed", "published", "redelivered", "lost"],
  "properties": {
    "name": { "type": "string" },
    "orders": {
      "type": "array",
      "description": "The business table: orders committed so far, in insertion order.",
      "items": {
        "type": "object",
        "required": ["id", "amount"],
        "properties": {
          "id": { "type": "string" },
          "amount": { "type": "integer" }
        }
      }
    },
    "outbox": {
      "type": "array",
      "description": "The outbox table: staged event rows, in insertion order.",
      "items": {
        "type": "object",
        "required": ["eventId", "type", "payload", "status"],
        "properties": {
          "eventId": { "type": "string" },
          "type": { "type": "string" },
          "payload": { "type": "string" },
          "status": { "enum": ["PENDING", "PUBLISHED"] }
        }
      }
    },
    "broker": {
      "type": "array",
      "description": "Events actually delivered to the broker (what consumers see), in delivery order.",
      "items": {
        "type": "object",
        "required": ["eventId", "type", "payload", "duplicate"],
        "properties": {
          "eventId": { "type": "string" },
          "type": { "type": "string" },
          "payload": { "type": "string" },
          "duplicate": { "type": "boolean" }
        }
      }
    },
    "committed": { "type": "integer", "description": "Transactions committed (business + outbox)." },
    "published": { "type": "integer", "description": "Events successfully published by the relay." },
    "redelivered": { "type": "integer", "description": "Events the relay sent more than once (duplicates)." },
    "lost": { "type": "integer", "description": "Events lost by a dual write with no outbox." },
    "action": {
      "type": "object",
      "description": "The action currently being handled (absent between actions).",
      "required": ["id", "info", "outcome"],
      "properties": {
        "id": { "type": "string" },
        "info": { "type": "string" },
        "outcome": { "enum": ["committed", "rolledback", "published", "redelivered", "lost"] }
      }
    }
  },
  "events": [
    "OUTBOX_CREATED",
    "TRANSACTION_COMMITTED",
    "TRANSACTION_ROLLED_BACK",
    "EVENT_PUBLISHED",
    "EVENT_REDELIVERED",
    "DUAL_WRITE_LOST"
  ]
}
