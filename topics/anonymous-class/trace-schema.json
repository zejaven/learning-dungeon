{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anonymous class trace event state",
  "description": "Shape of the `state` field for anonymous class trace events.",
  "type": "object",
  "required": [
    "targetType",
    "targetKind",
    "method",
    "relation",
    "variableName",
    "generatedClassName",
    "anonymousClass",
    "captured"
  ],
  "properties": {
    "targetType": { "type": "string" },
    "targetKind": { "type": "string" },
    "method": { "type": "string" },
    "relation": { "type": "string" },
    "variableName": { "type": "string" },
    "generatedClassName": { "type": "string" },
    "anonymousClass": { "type": "boolean" },
    "captured": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "lastCall": {
      "type": ["object", "null"],
      "properties": {
        "method": { "type": "string" },
        "result": { "type": "string" }
      }
    },
    "handoff": {
      "type": ["object", "null"],
      "properties": {
        "api": { "type": "string" },
        "argument": { "type": "string" }
      }
    }
  },
  "events": [
    "ANON_TARGET_DECLARED",
    "ANON_CLASS_CREATED",
    "ANON_LOCAL_CAPTURED",
    "ANON_METHOD_CALLED",
    "ANON_OBJECT_PASSED"
  ]
}
