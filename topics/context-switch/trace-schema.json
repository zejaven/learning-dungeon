{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context switch trace event state",
  "description": "Shape of the `state` field for Context Switch trace events.",
  "type": "object",
  "required": ["name", "cpu", "readyQueue", "waiting", "terminated", "contexts", "metrics", "history"],
  "properties": {
    "name": { "type": "string" },
    "cpu": {
      "type": "object",
      "required": ["core", "mode"],
      "properties": {
        "core": { "type": "string" },
        "mode": { "type": "string" },
        "runningThread": { "type": "string" },
        "pc": { "type": "integer" },
        "registerA": { "type": "integer" },
        "timeSliceUsed": { "type": "integer" }
      }
    },
    "readyQueue": {
      "type": "array",
      "items": { "$ref": "#/definitions/thread" }
    },
    "waiting": {
      "type": "array",
      "items": { "$ref": "#/definitions/thread" }
    },
    "terminated": {
      "type": "array",
      "items": { "$ref": "#/definitions/thread" }
    },
    "contexts": {
      "type": "array",
      "items": { "$ref": "#/definitions/thread" }
    },
    "metrics": {
      "type": "object",
      "required": ["contextSwitches", "overheadTicks", "usefulInstructions"],
      "properties": {
        "contextSwitches": { "type": "integer" },
        "overheadTicks": { "type": "integer" },
        "usefulInstructions": { "type": "integer" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "detail"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "thread": {
      "type": "object",
      "required": ["name", "state", "pc", "sp", "registerA", "saved", "runs", "timeSliceUsed"],
      "properties": {
        "name": { "type": "string" },
        "state": { "type": "string" },
        "pc": { "type": "integer" },
        "sp": { "type": "integer" },
        "registerA": { "type": "integer" },
        "saved": { "type": "boolean" },
        "runs": { "type": "integer" },
        "timeSliceUsed": { "type": "integer" },
        "waitReason": { "type": "string" },
        "lastSaveReason": { "type": "string" }
      }
    }
  },
  "events": [
    "CONTEXT_SWITCH_MODEL_CREATED",
    "THREAD_READY",
    "CONTEXT_RESTORED",
    "THREAD_DISPATCHED",
    "THREAD_EXECUTED",
    "CONTEXT_SAVED",
    "CONTEXT_SWITCHED",
    "THREAD_BLOCKED",
    "THREAD_WOKE",
    "THREAD_FINISHED",
    "CPU_IDLE"
  ]
}
