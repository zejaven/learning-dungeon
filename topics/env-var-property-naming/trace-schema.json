{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Property-name to environment-variable-name trace event state",
  "description": "Shape of the `state` field for env-var naming trace events: the conversion of one property name into a variable name, the variables the operating system holds, and the value each property ends up with.",
  "type": "object",
  "required": ["variables", "properties", "forms", "stats"],
  "properties": {
    "conversion": {
      "description": "The name rule applied to one property, step by step.",
      "type": ["object", "null"],
      "required": ["property", "envName", "done", "indexed", "steps"],
      "properties": {
        "property": { "type": "string" },
        "envName": { "type": "string" },
        "done": { "type": "boolean" },
        "indexed": { "type": "boolean" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "value", "changed"],
            "properties": {
              "id": { "type": "string", "enum": ["start", "separators", "dashes", "upper"] },
              "value": { "type": "string" },
              "changed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "variables": {
      "description": "The environment as the operating system holds it: names stored verbatim.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "value", "role"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "value": { "type": "string" },
          "role": { "type": "string", "enum": ["", "match", "near-miss"] }
        }
      }
    },
    "properties": {
      "description": "Every property seen so far, with the variable name that would override it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "key", "envName", "source"],
        "properties": {
          "id": { "type": "string" },
          "key": { "type": "string" },
          "envName": { "type": "string" },
          "fileValue": { "type": ["string", "null"] },
          "value": { "type": ["string", "null"] },
          "source": { "type": "string", "enum": ["none", "file", "env", "dropped"] }
        }
      }
    },
    "binding": {
      "description": "The outcome of the last resolve.",
      "type": ["object", "null"],
      "required": ["key", "envName", "matched", "reason"],
      "properties": {
        "key": { "type": "string" },
        "envName": { "type": "string" },
        "matched": { "type": "boolean" },
        "reason": {
          "type": "string",
          "enum": ["none", "canonical", "verbatim", "legacy", "lowercase"]
        },
        "variable": { "type": "string" },
        "value": { "type": ["string", "null"] },
        "fileValue": { "type": ["string", "null"] },
        "nearMisses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "getenv": {
      "type": ["object", "null"],
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": ["string", "null"] }
      }
    },
    "forms": {
      "description": "The same variable written the way each deployment tool wants it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "platform", "snippet"],
        "properties": {
          "id": { "type": "string" },
          "platform": { "type": "string" },
          "snippet": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["derived", "overridden", "missed"],
      "properties": {
        "derived": { "type": "integer" },
        "overridden": { "type": "integer" },
        "missed": { "type": "integer" }
      }
    }
  },
  "events": [
    "BINDING_READY",
    "PROPERTY_DECLARED",
    "VARIABLE_EXPORTED",
    "NAME_STEP",
    "ENV_NAME_DERIVED",
    "LIST_BINDING",
    "BINDING_MATCHED",
    "LIST_REPLACED",
    "BINDING_MISSED",
    "NEAR_MISS",
    "SYSTEM_GETENV",
    "DEPLOYMENT_FORMS",
    "NAMING_REPORT"
  ]
}
