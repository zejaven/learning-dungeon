{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "String concatenation trace event state",
  "description": "Shape of the `state` field for string-concatenation trace events.",
  "type": "object",
  "required": ["strategy", "iteration", "length", "allocations", "copies", "garbageObjects", "garbageChars", "live"],
  "properties": {
    "strategy": { "type": "string", "enum": ["CONCAT", "BUILDER"], "description": "which building strategy this run is showing" },
    "iteration": { "type": "integer", "description": "pieces appended/concatenated so far" },
    "piece": { "type": "string", "description": "the piece being added each iteration" },
    "length": { "type": "integer", "description": "current content length in characters" },
    "capacity": { "type": ["integer", "null"], "description": "buffer capacity (BUILDER only); null for CONCAT" },
    "allocations": { "type": "integer", "description": "total objects allocated so far" },
    "copies": { "type": "integer", "description": "cumulative characters copied (the work performed)" },
    "garbageObjects": { "type": "integer", "description": "objects left unreachable so far" },
    "garbageChars": { "type": "integer", "description": "characters held by garbage objects so far" },
    "live": {
      "type": "array",
      "description": "currently live objects (the result String, or the builder's char[] buffer).",
      "items": {
        "type": "object",
        "required": ["id", "kind", "value", "len"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["String", "char[]"] },
          "value": { "type": "string", "description": "content held so far" },
          "len": { "type": "integer", "description": "used characters" },
          "capacity": { "type": ["integer", "null"], "description": "char[] capacity; null for a String" }
        }
      }
    }
  },
  "events": [
    "CONCAT_START",
    "CONCAT_STEP",
    "CONCAT_DONE",
    "BUILDER_START",
    "BUILDER_PRESIZE",
    "BUILDER_APPEND",
    "BUILDER_GROW",
    "BUILDER_DONE"
  ]
}
