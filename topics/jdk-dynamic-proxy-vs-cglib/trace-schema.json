{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proxy factory trace event state",
  "description": "Shape of the `state` field for JDK-vs-CGLIB proxy trace events.",
  "type": "object",
  "required": ["target", "interfaces", "methods", "strategy", "log"],
  "properties": {
    "target": { "type": "string" },
    "finalClass": { "type": "boolean" },
    "proxyTargetClass": { "type": "boolean" },
    "interfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "isFinal"],
        "properties": {
          "name": { "type": "string" },
          "isFinal": { "type": "boolean" }
        }
      }
    },
    "strategy": { "type": "string", "enum": ["", "JDK", "CGLIB"] },
    "reason": { "type": "string" },
    "proxyName": { "type": "string" },
    "relation": { "type": "string", "enum": ["", "implements", "extends"] },
    "supertype": { "type": "string" },
    "created": { "type": "boolean" },
    "blocked": { "type": "boolean" },
    "phase": { "type": "string" },
    "activeMethod": { "type": "string" },
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "actor", "action", "method"],
        "properties": {
          "id": { "type": "string" },
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "method": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "PROXY_TARGET_DEFINED",
    "PROXY_INTERFACE_ADDED",
    "PROXY_METHOD_DEFINED",
    "PROXY_CONFIG",
    "PROXY_JDK_SELECTED",
    "PROXY_CGLIB_SELECTED",
    "PROXY_CREATED",
    "PROXY_FINAL_CLASS_BLOCKED",
    "PROXY_INVOKE",
    "PROXY_ADVICE",
    "PROXY_DELEGATE",
    "PROXY_RETURN",
    "PROXY_FINAL_METHOD_SKIPPED"
  ]
}
