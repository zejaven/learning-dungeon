{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Naive ArrayList growth trace event state",
  "description": "Shape of the state field for a deliberately naive grow-by-one ArrayList model. The state shows backing array slots, current size and capacity, the cost of the last append phase, and accumulated copy work.",
  "type": "object",
  "required": ["kind", "name", "capacity", "size", "slots", "lastOp"],
  "properties": {
    "kind": { "type": "string", "enum": ["naive-arraylist"] },
    "name": { "type": "string" },
    "capacity": { "type": "integer" },
    "size": { "type": "integer" },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "value"],
        "properties": {
          "index": { "type": "integer" },
          "value": { "type": ["string", "null"] }
        }
      }
    },
    "lastOp": {
      "type": "object",
      "required": [
        "phase",
        "copied",
        "write",
        "totalCopies",
        "totalWrites",
        "totalTouches",
        "formula",
        "complexity"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["created", "grow", "write", "total"]
        },
        "copied": {
          "type": "integer",
          "description": "How many existing references the last grow phase copied."
        },
        "write": {
          "type": "integer",
          "description": "How many new references the last write phase wrote."
        },
        "totalCopies": {
          "type": "integer",
          "description": "Cumulative copied references across the batch."
        },
        "totalWrites": {
          "type": "integer",
          "description": "Cumulative writes of new values."
        },
        "totalTouches": {
          "type": "integer",
          "description": "Cumulative copies plus writes."
        },
        "formula": { "type": "string" },
        "complexity": { "type": "string", "enum": ["O(N^2)"] }
      }
    }
  },
  "events": [
    "NAIVE_ARRAYLIST_CREATED",
    "NAIVE_ARRAYLIST_GROW",
    "NAIVE_ARRAYLIST_ADD",
    "NAIVE_ARRAYLIST_TOTAL"
  ]
}
