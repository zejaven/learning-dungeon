{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Happens-before trace event state",
  "description": "Shape of the state field for Java happens-before trace events.",
  "type": "object",
  "required": ["name", "variables", "threads", "monitors", "actions", "edges"],
  "properties": {
    "name": { "type": "string" },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "value", "lastWriter"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "value": { "type": ["string", "number", "boolean"] },
          "lastWriter": { "type": "string" }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "localValues"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "lastRefreshKind": { "type": "string" },
          "lastRefreshSourceThread": { "type": "string" },
          "localValues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string" },
                "value": { "type": ["string", "number", "boolean"] }
              }
            }
          }
        }
      }
    },
    "monitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "owner", "lastReleaseThread"],
        "properties": {
          "name": { "type": "string" },
          "owner": { "type": "string" },
          "lastReleaseThread": { "type": "string" }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "thread", "type", "target", "value"],
        "properties": {
          "id": { "type": "string" },
          "thread": { "type": "string" },
          "type": { "type": "string" },
          "target": { "type": "string" },
          "value": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind", "detail"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "events": [
    "HB_MODEL_CREATED",
    "PLAIN_WRITE",
    "PLAIN_READ",
    "PLAIN_READ_STALE",
    "VOLATILE_WRITE",
    "VOLATILE_READ",
    "VOLATILE_HAPPENS_BEFORE",
    "MONITOR_ACQUIRE",
    "MONITOR_RELEASE",
    "MONITOR_HAPPENS_BEFORE",
    "THREAD_START_EDGE",
    "THREAD_TERMINATED",
    "THREAD_JOIN_EDGE",
    "TRANSITIVE_VISIBILITY"
  ]
}
