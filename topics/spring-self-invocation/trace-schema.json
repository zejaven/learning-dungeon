{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spring @Transactional self-invocation trace event state",
  "description": "Shape of the state field for transactional self-invocation trace events.",
  "type": "object",
  "required": ["bean", "proxy", "activeTx", "registered", "stack", "transactions"],
  "properties": {
    "bean": { "type": "string" },
    "proxy": { "type": "string" },
    "activeTx": { "type": ["string", "null"] },
    "registered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "transactional", "propagation"],
        "properties": {
          "method": { "type": "string" },
          "transactional": { "type": "boolean" },
          "propagation": { "type": "string" }
        }
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "via", "declaredTx", "propagation", "ownsTx", "bypassed", "txId", "lastAction"],
        "properties": {
          "method": { "type": "string" },
          "via": { "type": "string", "enum": ["proxy", "this", "injected"] },
          "declaredTx": { "type": "boolean" },
          "propagation": { "type": "string" },
          "ownsTx": { "type": "boolean" },
          "bypassed": { "type": "boolean" },
          "txId": { "type": ["string", "null"] },
          "lastAction": { "type": "string" }
        }
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "propagation", "status"],
        "properties": {
          "id": { "type": "string" },
          "owner": { "type": "string" },
          "propagation": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "committed", "rolled-back"] }
        }
      }
    }
  },
  "events": [
    "SI_PROXY_CREATED",
    "SI_METHOD_REGISTERED",
    "SI_EXTERNAL_CALL",
    "SI_SELF_INVOKE",
    "SI_PROXY_REENTER",
    "SI_TX_BEGIN",
    "SI_TX_JOIN",
    "SI_TX_BYPASSED",
    "SI_WORK",
    "SI_TX_COMMIT",
    "SI_RETURN"
  ]
}
