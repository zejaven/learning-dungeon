{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thread vs ThreadPool trace event state",
  "description": "Shape of the state field for Thread vs ThreadPool trace events.",
  "type": "object",
  "required": ["name", "standaloneThreads", "pools", "history"],
  "properties": {
    "name": { "type": "string" },
    "standaloneThreads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "task", "state"],
        "properties": {
          "name": { "type": "string" },
          "task": { "type": "string" },
          "state": { "type": "string" }
        }
      }
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "workerCount",
          "queueCapacity",
          "shutdown",
          "workers",
          "queue",
          "completed",
          "rejected"
        ],
        "properties": {
          "name": { "type": "string" },
          "workerCount": { "type": "integer" },
          "queueCapacity": { "type": "integer" },
          "shutdown": { "type": "boolean" },
          "workers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "state", "tasksCompleted"],
              "properties": {
                "name": { "type": "string" },
                "state": { "type": "string" },
                "tasksCompleted": { "type": "integer" },
                "currentTask": { "type": "string" }
              }
            }
          },
          "queue": {
            "type": "array",
            "items": { "$ref": "#/definitions/task" }
          },
          "completed": {
            "type": "array",
            "items": { "$ref": "#/definitions/task" }
          },
          "rejected": {
            "type": "array",
            "items": { "$ref": "#/definitions/task" }
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "target"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "task": {
      "type": "object",
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string" },
        "state": { "type": "string" },
        "assignedWorker": { "type": "string" },
        "rejectionReason": { "type": "string" }
      }
    }
  },
  "events": [
    "THREAD_POOL_MODEL_CREATED",
    "THREAD_CREATED_PER_TASK",
    "THREAD_STARTED_PER_TASK",
    "THREAD_TERMINATED_AFTER_TASK",
    "THREAD_POOL_CREATED",
    "POOL_TASK_SUBMITTED",
    "POOL_TASK_ASSIGNED",
    "POOL_TASK_QUEUED",
    "POOL_TASK_COMPLETED",
    "POOL_WORKER_REUSED",
    "POOL_TASK_REJECTED",
    "THREAD_POOL_SHUTDOWN"
  ]
}
