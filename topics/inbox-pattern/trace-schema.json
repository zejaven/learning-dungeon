{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inbox pattern trace event state",
  "description": "Shape of the `state` field for inbox-pattern trace events.",
  "type": "object",
  "required": ["inbox", "processedCount", "skippedCount", "effect"],
  "properties": {
    "name": { "type": "string" },
    "inbox": {
      "type": "array",
      "description": "Message ids already processed (the inbox table), in arrival order.",
      "items": {
        "type": "object",
        "required": ["id", "payload", "amount"],
        "properties": {
          "id": { "type": "string" },
          "payload": { "type": "string" },
          "amount": { "type": "integer" }
        }
      }
    },
    "processedCount": { "type": "integer" },
    "skippedCount": { "type": "integer" },
    "effect": {
      "type": "integer",
      "description": "Cumulative business effect, e.g. total amount charged."
    },
    "message": {
      "type": "object",
      "description": "The message currently being handled (absent between receives).",
      "required": ["id", "payload", "amount", "outcome"],
      "properties": {
        "id": { "type": "string" },
        "payload": { "type": "string" },
        "amount": { "type": "integer" },
        "outcome": { "enum": ["received", "processed", "duplicate"] }
      }
    }
  },
  "events": [
    "INBOX_CREATED",
    "MESSAGE_RECEIVED",
    "MESSAGE_PROCESSED",
    "DUPLICATE_SKIPPED",
    "INBOX_CLEANUP"
  ]
}
