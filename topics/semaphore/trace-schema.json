{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semaphore trace event state",
  "description": "Shape of the state field for Semaphore trace events.",
  "type": "object",
  "required": [
    "name",
    "initialPermits",
    "availablePermits",
    "trackedPermits",
    "fair",
    "holders",
    "waitingQueue",
    "history"
  ],
  "properties": {
    "name": { "type": "string" },
    "initialPermits": { "type": "integer" },
    "availablePermits": { "type": "integer" },
    "trackedPermits": { "type": "integer" },
    "fair": { "type": "boolean" },
    "holders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "permits"],
        "properties": {
          "thread": { "type": "string" },
          "permits": { "type": "integer" }
        }
      }
    },
    "waitingQueue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "permits"],
        "properties": {
          "thread": { "type": "string" },
          "permits": { "type": "integer" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "action", "permits"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "type": "string" },
          "permits": { "type": "integer" }
        }
      }
    }
  },
  "events": [
    "SEMAPHORE_CREATED",
    "SEMAPHORE_ACQUIRE",
    "SEMAPHORE_WAIT",
    "SEMAPHORE_TRY_ACQUIRE_SUCCESS",
    "SEMAPHORE_TRY_ACQUIRE_FAILED",
    "SEMAPHORE_RELEASE",
    "SEMAPHORE_NO_OWNER_RELEASE",
    "SEMAPHORE_PERMIT_GRANTED",
    "SEMAPHORE_OVER_RELEASE"
  ]
}
