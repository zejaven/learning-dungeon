{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HashMap basics trace event state",
  "description": "Shape of the state field for VisualHashMap trace events.",
  "type": "object",
  "required": ["capacity", "buckets"],
  "properties": {
    "name": { "type": "string" },
    "capacity": { "type": "integer" },
    "loadFactor": { "type": "number" },
    "threshold": { "type": "integer" },
    "size": { "type": "integer" },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "nodes"],
        "properties": {
          "index": { "type": "integer" },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "value", "hash"],
              "properties": {
                "key": { "type": "string" },
                "value": { "type": "string" },
                "hash": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  },
  "events": [
    "HASHMAP_CREATED",
    "HASHMAP_PUT",
    "HASHMAP_COLLISION",
    "HASHMAP_GET",
    "HASHMAP_RESIZE"
  ]
}
